<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LeiterWatercolorStudio.App.Controls.SettingInfoIcon"
             Focusable="False"
             HorizontalAlignment="Left"
             VerticalAlignment="Center">
    <UserControl.Styles>
        <Style Selector="Border#PART_HitTarget:pointerover Border#PART_Circle">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource StudioSelectedBrush}" />
        </Style>
        <Style Selector="Border#PART_HitTarget:pointerover Ellipse#PART_GlyphDot">
            <Setter Property="Fill" Value="{DynamicResource StudioAccentBrush}" />
        </Style>
        <Style Selector="Border#PART_HitTarget:pointerover Border#PART_GlyphStem">
            <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="PART_HitTarget"
            Width="18"
            Height="18"
            Padding="2"
            Background="Transparent"
            Cursor="Help"
            IsVisible="False">
        <Border x:Name="PART_Circle"
                Width="14"
                Height="14"
                CornerRadius="7"
                BorderThickness="1"
                BorderBrush="{DynamicResource StudioMutedBrush}"
                Background="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Canvas Width="12" Height="12">
                <Ellipse x:Name="PART_GlyphDot"
                         Width="2"
                         Height="2"
                         Canvas.Left="5"
                         Canvas.Top="2"
                         Fill="{DynamicResource StudioMutedBrush}" />
                <Border x:Name="PART_GlyphStem"
                        Width="2"
                        Height="5"
                        CornerRadius="1"
                        Canvas.Left="5"
                        Canvas.Top="5"
                        Background="{DynamicResource StudioMutedBrush}" />
            </Canvas>
        </Border>
    </Border>
</UserControl>
