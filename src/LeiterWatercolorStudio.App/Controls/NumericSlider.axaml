<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LeiterWatercolorStudio.App.Controls"
             x:Class="LeiterWatercolorStudio.App.Controls.NumericSlider"
             Margin="0,2">
    <StackPanel Spacing="1">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <Grid Grid.Column="0"
                  ColumnDefinitions="*,Auto"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
                <Border x:Name="PART_LabelArea"
                        Grid.Column="0"
                        Background="Transparent"
                        VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*"
                          VerticalAlignment="Center">
                        <Ellipse x:Name="PART_ModifiedDot"
                                 Grid.Column="0"
                                 Width="6"
                                 Height="6"
                                 Fill="#38BDF8"
                                 Margin="0,0,5,0"
                                 VerticalAlignment="Center"
                                 IsVisible="False" />
                        <TextBlock x:Name="PART_LabelText"
                                   Grid.Column="1"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <controls:SettingInfoIcon x:Name="PART_InfoIcon"
                                          Grid.Column="1"
                                          Margin="3,0,0,0"
                                          VerticalAlignment="Center"
                                          IsVisible="False" />
            </Grid>

            <TextBox x:Name="PART_ValueTextBox"
                     Grid.Column="1"
                     MinWidth="60"
                     Width="66"
                     Height="24"
                     MinHeight="24"
                     Padding="6,2"
                     FontSize="11.5"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="6,0,0,0" />

            <TextBlock x:Name="PART_UnitText"
                       Grid.Column="2"
                       FontSize="11"
                       Opacity="0.68"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"
                       IsVisible="False" />

            <Button x:Name="PART_ResetButton"
                    Grid.Column="3"
                    Content="↺"
                    Width="22"
                    Height="22"
                    Padding="0"
                    FontSize="12"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="4,0,0,0"
                    ToolTip.Tip="Reset to baseline (or double-click label / track)" />
        </Grid>

        <Slider x:Name="PART_Slider"
                Minimum="0"
                Maximum="1"
                Value="0"
                SmallChange="0.01"
                LargeChange="0.1"
                MinHeight="20"
                Margin="0,-3,0,0" />

        <TextBlock x:Name="PART_ValidationErrorText"
                   Classes="validation-error"
                   IsVisible="False" />
    </StackPanel>
</UserControl>
