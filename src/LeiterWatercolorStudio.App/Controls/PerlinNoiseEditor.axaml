<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LeiterWatercolorStudio.App.Controls"
             xmlns:converters="using:LeiterWatercolorStudio.App.Converters"
             xmlns:params="clr-namespace:LeiterWatercolorStudio.Core.Parameters;assembly=LeiterWatercolorStudio.Core"
             x:Class="LeiterWatercolorStudio.App.Controls.PerlinNoiseEditor"
             x:DataType="params:PerlinNoiseViewModel">
    <Border BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="6"
            Background="#141820"
            Padding="10,8">
        <StackPanel Spacing="6">
            <!-- Collapsible Card Header -->
            <Grid ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0"
                      ColumnDefinitions="*,Auto"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                    <Button x:Name="PART_ExpandButton"
                            Grid.Column="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2,2"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="PART_ChevronText"
                                       Text="▾"
                                       FontSize="11"
                                       Opacity="0.75"
                                       VerticalAlignment="Center" />
                            <Ellipse x:Name="PART_ModifiedDot"
                                     Width="6"
                                     Height="6"
                                     Fill="#38BDF8"
                                     VerticalAlignment="Center"
                                     IsVisible="False" />
                            <TextBlock x:Name="PART_TitleText"
                                       Text="Noise"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <controls:SettingInfoIcon x:Name="PART_TitleInfoIcon"
                                              Grid.Column="1"
                                              Margin="2,0,0,0"
                                              VerticalAlignment="Center" />
                </Grid>

                <Button x:Name="PART_ResetButton"
                        Grid.Column="1"
                        Content="↺"
                        Width="24"
                        Height="24"
                        Padding="0"
                        FontSize="12"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip.Tip="Reset noise parameters to baseline" />
            </Grid>

            <!-- Collapsible Editor Body -->
            <StackPanel x:Name="PART_BodyPanel" Spacing="4">
                <!-- Seed Row -->
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,*,Auto"
                      Margin="0,2,0,2">
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="3"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <TextBlock Text="Seed"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="Integer pseudo-random seed initializing the Perlin noise permutation table." />
                        <controls:SettingInfoIcon x:Name="PART_SeedInfoIcon"
                                                  Header="Seed" />
                    </StackPanel>
                    <TextBox x:Name="PART_SeedTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             MinHeight="26"
                             Height="26"
                             Padding="6,2"
                             FontSize="12"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="PART_RandomizeSeedButton"
                            Grid.Row="0"
                            Grid.Column="2"
                            Content="🎲 Random"
                            Height="26"
                            Padding="8,2"
                            FontSize="11.5"
                            Margin="6,0,0,0"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Generate a new random seed" />
                    <TextBlock x:Name="PART_SeedErrorText"
                               Grid.Row="1"
                               Grid.ColumnSpan="3"
                               Classes="validation-error"
                               IsVisible="False" />
                </Grid>

                <controls:NumericSlider x:Name="PART_FrequencySlider"
                                        Label="Frequency"
                                        Description="Base spatial sampling frequency (cycles per pixel) of the first Perlin noise octave."
                                        Minimum="0.001"
                                        Maximum="0.5"
                                        ValidMinimum="0"
                                        IsValidMinimumExclusive="True"
                                        Step="0.001"
                                        FormatString="F3"
                                        Value="{Binding Frequency, Mode=TwoWay}"
                                        BaselineValue="{Binding Baseline.Frequency, Mode=OneWay}" />

                <controls:NumericSlider x:Name="PART_OctavesSlider"
                                        Label="Octaves"
                                        Description="Number of layered fractal Brownian motion (fBm) noise octaves summed together."
                                        Minimum="1"
                                        Maximum="16"
                                        ValidMinimum="1"
                                        ValidMaximum="16"
                                        Step="1"
                                        IsInteger="True"
                                        FormatString="F0"
                                        Value="{Binding Octaves, Mode=TwoWay, Converter={x:Static converters:IntToDoubleConverter.Instance}}"
                                        BaselineValue="{Binding Baseline.Octaves, Mode=OneWay, Converter={x:Static converters:IntToDoubleConverter.Instance}}" />

                <controls:NumericSlider x:Name="PART_LacunaritySlider"
                                        Label="Lacunarity"
                                        Description="Frequency multiplier between consecutive fractal noise octaves."
                                        Minimum="1.0"
                                        Maximum="4.0"
                                        ValidMinimum="0"
                                        IsValidMinimumExclusive="True"
                                        Step="0.05"
                                        FormatString="F2"
                                        Value="{Binding Lacunarity, Mode=TwoWay}"
                                        BaselineValue="{Binding Baseline.Lacunarity, Mode=OneWay}" />

                <controls:NumericSlider x:Name="PART_PersistenceSlider"
                                        Label="Persistence"
                                        Description="Amplitude decay factor applied to each successive fractal noise octave."
                                        Minimum="0.0"
                                        Maximum="1.0"
                                        ValidMinimum="0"
                                        Step="0.01"
                                        FormatString="F2"
                                        Value="{Binding Persistence, Mode=TwoWay}"
                                        BaselineValue="{Binding Baseline.Persistence, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
