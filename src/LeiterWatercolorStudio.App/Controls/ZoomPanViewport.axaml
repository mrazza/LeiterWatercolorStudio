<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LeiterWatercolorStudio.App.Controls"
             x:Class="LeiterWatercolorStudio.App.Controls.ZoomPanViewport"
             x:DataType="controls:ZoomPanViewport"
             DragDrop.AllowDrop="True"
             Focusable="True"
             ClipToBounds="True"
             Background="{DynamicResource StudioViewportMatBrush}">
    <UserControl.Styles>
        <Style Selector="Border.hud-pill">
            <Setter Property="Background" Value="{DynamicResource StudioHudBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioHudBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="5,4" />
        </Style>

        <Style Selector="Border.pane-badge">
            <Setter Property="Background" Value="{DynamicResource StudioPaneBadgeBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioPaneBadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <Style Selector="Button.hud-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource StudioHudForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.hud-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioHoverHudBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioHudForegroundBrush}" />
        </Style>

        <Style Selector="Button.hud-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioHoverHudPressedBrush}" />
        </Style>

        <Style Selector="Button.mode-chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource StudioHudMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.mode-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioHoverHudBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioHudForegroundBrush}" />
        </Style>

        <Style Selector="Button.mode-chip.active">
            <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.mode-chip.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioAccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
        </Style>

        <Style Selector="Button.reseed-chip">
            <Setter Property="Background" Value="{DynamicResource StudioReseedChipBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioReseedChipFgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioReseedChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.reseed-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioReseedChipHoverBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioReseedChipFgBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Rendered bitmap surface -->
        <controls:ViewportSurface x:Name="PART_Surface"
                                  IsHitTestVisible="False" />

        <!-- Split-wipe interactive divider & handle -->
        <Canvas x:Name="PART_WipeOverlay"
                IsVisible="False">
            <Border x:Name="PART_WipeLine"
                    Width="2"
                    Background="{DynamicResource StudioWipeLineBrush}"
                    IsHitTestVisible="False" />
            <Border x:Name="PART_WipeHandle"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Background="{DynamicResource StudioWipeHandleBgBrush}"
                    BorderBrush="{DynamicResource StudioWipeHandleBorderBrush}"
                    BorderThickness="1.5"
                    Cursor="SizeWestEast">
                <TextBlock Text="◄ ►"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource StudioHudForegroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Canvas>

        <!-- Floating Studio HUD Overlay -->
        <Grid x:Name="PART_HudOverlay"
              Margin="12"
              RowDefinitions="Auto,*,Auto">
            <!-- Row 0: Visualization Modes (Top-Left, or Right Pane in Side-by-Side) + Zoom Controls (Top-Right) -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto">
                <Border x:Name="PART_ModeBar"
                        Grid.Column="0"
                        Classes="hud-pill"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsVisible="False">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <WrapPanel x:Name="PART_ModeChips"
                                   Orientation="Horizontal" />
                        <Border x:Name="PART_ReseedSeparator"
                                Width="1"
                                Margin="2,3"
                                Background="{DynamicResource StudioHudBorderBrush}"
                                IsVisible="False" />
                        <Button x:Name="PART_ReseedButton"
                                Classes="reseed-chip"
                                Content="Reseed"
                                ToolTip.Tip="Generate a new random noise seed"
                                IsVisible="False" />
                    </StackPanel>
                </Border>

                <Border x:Name="PART_ZoomBar"
                        Grid.Column="1"
                        Classes="hud-pill"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="2">
                        <Button x:Name="PART_FitButton"
                                Classes="hud-btn"
                                Content="Fit"
                                ToolTip.Tip="Fit image to viewport (Ctrl+0)" />
                        <Button x:Name="PART_OneToOneButton"
                                Classes="hud-btn"
                                Content="1:1"
                                ToolTip.Tip="Zoom to 100% / 1:1 pixels (Ctrl+1)" />
                        <Border Width="1"
                                Margin="3,4"
                                Background="{DynamicResource StudioHudBorderBrush}" />
                        <Button x:Name="PART_ZoomOutButton"
                                Classes="hud-btn"
                                Content="−"
                                Width="26"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Zoom out (Ctrl+-)" />
                        <TextBlock x:Name="PART_ZoomText"
                                   Text="100%"
                                   MinWidth="46"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StudioHudForegroundBrush}"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <Button x:Name="PART_ZoomInButton"
                                Classes="hud-btn"
                                Content="+"
                                Width="26"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Zoom in (Ctrl++)" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 1: Pane labels for SplitWipe / SideBySide / Hold-to-Compare -->
            <Grid Grid.Row="1"
                  Margin="0,8,0,0"
                  IsHitTestVisible="False">
                <!-- Hold-to-Compare badge -->
                <Border x:Name="PART_HoldCompareBadge"
                        Classes="pane-badge"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsVisible="False">
                    <TextBlock x:Name="PART_HoldCompareLabel"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StudioHudForegroundBrush}" />
                </Border>

                <!-- Side-by-Side pane labels -->
                <Grid x:Name="PART_SideBySideLabels"
                      ColumnDefinitions="*,*"
                      IsVisible="False">
                    <Border x:Name="PART_SideCompareBadge"
                            Grid.Column="0"
                            Classes="pane-badge"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsVisible="False">
                        <TextBlock x:Name="PART_SideCompareLabel"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StudioHudForegroundBrush}" />
                    </Border>
                    <Border x:Name="PART_SidePrimaryBadge"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Classes="pane-badge"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsVisible="False">
                        <TextBlock x:Name="PART_SidePrimaryLabel"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StudioHudForegroundBrush}" />
                    </Border>
                </Grid>

                <!-- Split-Wipe pane labels -->
                <Grid x:Name="PART_WipeLabels"
                      IsVisible="False">
                    <Border x:Name="PART_WipeCompareBadge"
                            Classes="pane-badge"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsVisible="False">
                        <TextBlock x:Name="PART_WipeCompareLabel"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StudioHudForegroundBrush}" />
                    </Border>
                    <Border x:Name="PART_WipePrimaryBadge"
                            Classes="pane-badge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsVisible="False">
                        <TextBlock x:Name="PART_WipePrimaryLabel"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StudioHudForegroundBrush}" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Row 2: Compact 1-line Hover Pixel HUD (Bottom-Left) + Processing Pill with Cancel (Bottom-Right) -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto">
                <Border x:Name="PART_HoverHud"
                        Grid.Column="0"
                        Classes="hud-pill"
                        Padding="8,5"
                        CornerRadius="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        IsHitTestVisible="False"
                        IsVisible="False">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border x:Name="PART_HoverSwatch"
                                Width="16"
                                Height="16"
                                CornerRadius="3"
                                BorderBrush="{DynamicResource StudioHudBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                IsVisible="False" />
                        <TextBlock x:Name="PART_HoverHudText"
                                   FontFamily="Consolas, Menlo, Monaco, monospace"
                                   FontSize="11"
                                   Foreground="{DynamicResource StudioHudForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border x:Name="PART_ProcessingPill"
                        Grid.Column="1"
                        Classes="hud-pill"
                        Padding="10,5"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        IsVisible="False">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{DynamicResource StudioAccentBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="PART_ProcessingText"
                                   Text="Processing..."
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource StudioHudForegroundBrush}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="PART_CancelButton"
                                Classes="hud-btn"
                                Content="Cancel"
                                Padding="7,2"
                                MinHeight="22"
                                Foreground="{DynamicResource StudioDangerBrush}"
                                ToolTip.Tip="Cancel active render (Escape)" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Empty State Card -->
        <Border x:Name="PART_EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Padding="32,28"
                CornerRadius="14"
                Background="{DynamicResource StudioEmptyCardBrush}"
                BorderBrush="{DynamicResource StudioEmptyCardBorderBrush}"
                BorderThickness="1"
                IsVisible="True">
            <StackPanel Spacing="12"
                        HorizontalAlignment="Center">
                <Border Width="48"
                        Height="48"
                        CornerRadius="24"
                        Background="{DynamicResource StudioSelectedBrush}"
                        BorderBrush="{DynamicResource StudioAccentBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Path Width="22"
                          Height="22"
                          Stretch="Uniform"
                          Fill="{DynamicResource StudioAccentBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A1.5,1.5 0 0,0 13.5,19.5C13.5,19.11 13.35,18.76 13.11,18.5C12.88,18.23 12.73,17.88 12.73,17.5A1.5,1.5 0 0,1 14.23,16H16A5,5 0 0,0 21,11C21,6.58 16.97,3 12,3M6.5,12A1.5,1.5 0 0,1 5,10.5A1.5,1.5 0 0,1 6.5,9A1.5,1.5 0 0,1 8,10.5A1.5,1.5 0 0,1 6.5,12M9.5,8A1.5,1.5 0 0,1 8,6.5A1.5,1.5 0 0,1 9.5,5A1.5,1.5 0 0,1 11,6.5A1.5,1.5 0 0,1 9.5,8M14.5,8A1.5,1.5 0 0,1 13,6.5A1.5,1.5 0 0,1 14.5,5A1.5,1.5 0 0,1 16,6.5A1.5,1.5 0 0,1 14.5,8M17.5,12A1.5,1.5 0 0,1 16,10.5A1.5,1.5 0 0,1 17.5,9A1.5,1.5 0 0,1 19,10.5A1.5,1.5 0 0,1 17.5,12Z" />
                </Border>
                <TextBlock Text="Open an Image to Begin"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StudioForegroundBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Drag and drop a PNG, JPEG, BMP, or WebP image anywhere, choose a file from disk, or explore with a sample photo."
                           FontSize="12"
                           Foreground="{DynamicResource StudioMutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0">
                    <Button x:Name="PART_OpenImageButton"
                            Classes="studio-accent"
                            Content="Open Image..."
                            Padding="16,8"
                            CornerRadius="8"
                            FontSize="13"
                            ToolTip.Tip="Open a source image from disk (Ctrl+O)" />
                    <Button x:Name="PART_TrySampleButton"
                            Classes="studio-btn"
                            Content="Try Sample Photo"
                            Padding="14,8"
                            CornerRadius="8"
                            FontSize="13"
                            ToolTip.Tip="Load a built-in landscape photo to preview watercolor effects immediately" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Drag-and-Drop Overlay -->
        <Border x:Name="PART_DropOverlay"
                Margin="8"
                CornerRadius="12"
                BorderBrush="{DynamicResource StudioDropOverlayBorderBrush}"
                BorderThickness="2"
                Background="{DynamicResource StudioDropOverlayBgBrush}"
                IsHitTestVisible="False"
                IsVisible="False">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="18,10"
                    CornerRadius="10"
                    Background="{DynamicResource StudioDropPillBgBrush}"
                    BorderBrush="{DynamicResource StudioAccentBrush}"
                    BorderThickness="1">
                <TextBlock Text="Drop image to open"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StudioForegroundBrush}" />
            </Border>
        </Border>
    </Grid>
</UserControl>
