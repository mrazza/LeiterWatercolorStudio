<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LeiterWatercolorStudio.App.Controls"
             xmlns:vm="using:LeiterWatercolorStudio.App.ViewModels"
             x:Class="LeiterWatercolorStudio.App.Controls.PipelineFilmstrip"
             x:Name="Root"
             x:DataType="controls:PipelineFilmstrip">

    <UserControl.Styles>
        <!-- Sub-stage pill button styles -->
        <Style Selector="Button.substage-pill">
            <Setter Property="Background" Value="{DynamicResource StudioPillBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioSecondaryForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioPillBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,1,6,1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.substage-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioPillHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioPillHoverBorderBrush}" />
        </Style>
        <Style Selector="Button.substage-pill.bypassed">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.substage-pill.stale">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioStatusStaleBorderBrush}" />
        </Style>
        <Style Selector="Button.substage-pill.cached">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioStatusCachedBorderBrush}" />
        </Style>
        <Style Selector="Button.substage-pill.running">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioStatusRunningBorderBrush}" />
        </Style>
        <Style Selector="Button.substage-pill.selected">
            <Setter Property="Background" Value="{DynamicResource StudioPillActiveBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioPillActiveBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioForegroundBrush}" />
        </Style>
        <Style Selector="Button.substage-pill.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioPillActiveHoverBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
        </Style>

        <!-- Primary stage card styles -->
        <Style Selector="Border.stage-card">
            <Setter Property="Background" Value="{DynamicResource StudioFilmstripCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioFilmstripCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.stage-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource StudioFilmstripCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioFilmstripCardHoverBorderBrush}" />
        </Style>
        <Style Selector="Border.stage-card.bypassed">
            <Setter Property="Background" Value="{DynamicResource StudioFilmstripCardBypassedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioFilmstripCardBypassedBorderBrush}" />
        </Style>
        <Style Selector="Border.stage-card.bypassed Border.thumb-frame">
            <Setter Property="Opacity" Value="0.48" />
        </Style>
        <Style Selector="Border.stage-card.cached">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioCachedBrush}" />
        </Style>
        <Style Selector="Border.stage-card.stale">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioStaleBrush}" />
        </Style>
        <Style Selector="Border.stage-card.running">
            <Setter Property="Background" Value="{DynamicResource StudioFilmstripCardRunningBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioStatusRunningBorderBrush}" />
        </Style>
        <Style Selector="Border.stage-card.selected">
            <Setter Property="Background" Value="{DynamicResource StudioFilmstripCardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.stage-card.selected:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentHoverBrush}" />
        </Style>

        <!-- Status dots (priority: idle -> bypassed -> cached -> stale -> running) -->
        <Style Selector="Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource StudioMutedBrush}" />
        </Style>
        <Style Selector=".bypassed Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource StudioStatusBypassedFgBrush}" />
        </Style>
        <Style Selector=".cached Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource StudioCachedBrush}" />
        </Style>
        <Style Selector=".stale Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource StudioStaleBrush}" />
        </Style>
        <Style Selector=".running Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource StudioStatusRunningBorderBrush}" />
        </Style>

        <!-- Status badge pills -->
        <Style Selector="Border.status-pill">
            <Setter Property="Background" Value="{DynamicResource StudioSurfaceAltBrush}" />
        </Style>
        <Style Selector="Border.status-pill TextBlock.status-pill-text">
            <Setter Property="Foreground" Value="{DynamicResource StudioSecondaryForegroundBrush}" />
        </Style>
        <Style Selector=".bypassed Border.status-pill">
            <Setter Property="Background" Value="{DynamicResource StudioStatusBypassedBgBrush}" />
        </Style>
        <Style Selector=".bypassed Border.status-pill TextBlock.status-pill-text">
            <Setter Property="Foreground" Value="{DynamicResource StudioStatusBypassedFgBrush}" />
        </Style>
        <Style Selector=".cached Border.status-pill">
            <Setter Property="Background" Value="{DynamicResource StudioStatusCachedBgBrush}" />
        </Style>
        <Style Selector=".cached Border.status-pill TextBlock.status-pill-text">
            <Setter Property="Foreground" Value="{DynamicResource StudioStatusCachedFgBrush}" />
        </Style>
        <Style Selector=".stale Border.status-pill">
            <Setter Property="Background" Value="{DynamicResource StudioStatusStaleBgBrush}" />
        </Style>
        <Style Selector=".stale Border.status-pill TextBlock.status-pill-text">
            <Setter Property="Foreground" Value="{DynamicResource StudioStatusStaleFgBrush}" />
        </Style>
        <Style Selector=".running Border.status-pill">
            <Setter Property="Background" Value="{DynamicResource StudioStatusRunningBgBrush}" />
        </Style>
        <Style Selector=".running Border.status-pill TextBlock.status-pill-text">
            <Setter Property="Foreground" Value="{DynamicResource StudioStatusRunningFgBrush}" />
        </Style>

        <!-- Pin button (overlays thumbnail top-right on hover or when pinned, freeing card header width) -->
        <Style Selector="Button.pin-btn">
            <Setter Property="Background" Value="{DynamicResource StudioHudBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioHudBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.stage-card:pointerover Button.pin-btn">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.pin-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioPinHoverBgBrush}" />
        </Style>
        <Style Selector="Button.pin-btn Path.pin-glyph">
            <Setter Property="Fill" Value="{DynamicResource StudioMutedBrush}" />
        </Style>
        <Style Selector="Button.pin-btn.pinned">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource StudioPinPinnedBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioPinPinnedFgBrush}" />
        </Style>
        <Style Selector="Button.pin-btn.pinned Path.pin-glyph, Button.compact-pin-btn.pinned Path.pin-glyph">
            <Setter Property="Fill" Value="{DynamicResource StudioPinPinnedFgBrush}" />
        </Style>

        <!-- Compact header pin button (visible only when filmstrip is dragged into compact text-only height) -->
        <Style Selector="Button.compact-pin-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.stage-card:pointerover Button.compact-pin-btn">
            <Setter Property="Opacity" Value="0.95" />
        </Style>
        <Style Selector="Button.compact-pin-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioPinHoverBgBrush}" />
        </Style>
        <Style Selector="Button.compact-pin-btn Path.pin-glyph">
            <Setter Property="Fill" Value="{DynamicResource StudioMutedBrush}" />
        </Style>
        <Style Selector="Button.compact-pin-btn.pinned">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource StudioPinPinnedBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioPinPinnedFgBrush}" />
        </Style>

        <!-- Hide trailing chevron after the final stage card while preserving equal column width -->
        <Style Selector="ItemsControl#PrimaryStagesItemsControl ContentPresenter:nth-last-child(1) TextBlock.stage-chevron">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource StudioFilmstripBgBrush}"
            Padding="10,6">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
            <!-- Persistent Sub-Stage Bar (constant MinHeight prevents canvas height jump) -->
            <Border Grid.Row="0"
                    MinHeight="38"
                    Background="{DynamicResource StudioSubStageBarBgBrush}"
                    BorderBrush="{DynamicResource StudioSubStageBarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,4">
                <Panel VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*"
                          IsVisible="{Binding #Root.ShowSubStageDrawer}">
                        <TextBlock Grid.Column="0"
                                   Text="SUB-STAGES"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource StudioMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,10,0" />
                        <ItemsControl x:Name="SubStagesItemsControl"
                                      Grid.Column="1"
                                      ItemsSource="{Binding #Root.SubStages}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SubStageItemViewModel">
                                    <Button Classes="substage-pill"
                                            Classes.selected="{Binding IsSelected}"
                                            Classes.running="{Binding IsRunning}"
                                            Classes.stale="{Binding IsStale}"
                                            Classes.cached="{Binding IsFromCache}"
                                            Classes.bypassed="{Binding IsBypassed}"
                                            Click="OnSubStageClick">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Ellipse Classes="status-dot" Width="7" Height="7" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11.5"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource StudioPillTimingBgBrush}"
                                                    CornerRadius="8"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimingText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource StudioMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !#Root.ShowSubStageDrawer}">
                        <TextBlock Text="STAGE VIEW"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource StudioMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />
                        <TextBlock Text="{Binding #Root.ActiveStageSummary}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource StudioMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </Border>

            <!-- Responsive Primary 8-Stage Filmstrip -->
            <ItemsControl x:Name="PrimaryStagesItemsControl"
                          Grid.Row="1"
                          ItemsSource="{Binding #Root.Stages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StageCardViewModel">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Stretch">
                            <Border Grid.Column="0"
                                    Classes="stage-card"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.running="{Binding IsRunning}"
                                    Classes.stale="{Binding IsStale}"
                                    Classes.cached="{Binding IsFromCache}"
                                    Classes.bypassed="{Binding IsBypassed}"
                                    Classes.pinned="{Binding IsPinned}"
                                    MinWidth="96"
                                    CornerRadius="8"
                                    Padding="6,5"
                                    Cursor="Hand"
                                    Focusable="True"
                                    PointerPressed="OnStageCardPointerPressed">
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="4">
                                    <!-- Card Header (full width for stage title + compact-only pin toggle) -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                                        <Border Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                CornerRadius="4"
                                                Background="{DynamicResource StudioSurfaceAltBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortcutText}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource StudioSecondaryForegroundBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StudioForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Title}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="▾"
                                                   IsVisible="{Binding HasSubStages}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource StudioMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Classes="compact-pin-btn"
                                                Classes.pinned="{Binding IsPinned}"
                                                IsVisible="{Binding #Root.IsCompactHeight}"
                                                Click="OnPinButtonClick"
                                                ToolTip.Tip="Pin stage for A/B comparison">
                                            <Path Classes="pin-glyph"
                                                  Width="9"
                                                  Height="9"
                                                  Stretch="Uniform"
                                                  Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" />
                                        </Button>
                                        <Ellipse Grid.Column="4"
                                                 Classes="status-dot"
                                                 Width="7"
                                                 Height="7"
                                                 VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Adaptive Thumbnail Preview + Hover/Pinned Pin Button (hidden in compact text-only height) -->
                                    <Border Grid.Row="1"
                                            Classes="thumb-frame"
                                            IsVisible="{Binding !#Root.IsCompactHeight}"
                                            Background="{DynamicResource StudioFilmstripThumbBgBrush}"
                                            BorderBrush="{DynamicResource StudioFilmstripThumbBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            ClipToBounds="True">
                                        <Panel>
                                            <TextBlock Text="—"
                                                       IsVisible="{Binding !HasThumbnail}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource StudioMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Classes="stage-thumb"
                                                   Source="{Binding Thumbnail}"
                                                   IsVisible="{Binding HasThumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            <Button Classes="pin-btn"
                                                    Classes.pinned="{Binding IsPinned}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="3"
                                                    Click="OnPinButtonClick"
                                                    ToolTip.Tip="Pin stage for A/B comparison">
                                                <Path Classes="pin-glyph"
                                                      Width="10"
                                                      Height="10"
                                                      Stretch="Uniform"
                                                      Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" />
                                            </Button>
                                        </Panel>
                                    </Border>

                                    <!-- Card Footer -->
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TimingText}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource StudioMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                Classes="status-pill"
                                                IsVisible="{Binding HasStatusBadge}"
                                                CornerRadius="4"
                                                Padding="4,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Classes="status-pill-text"
                                                       Text="{Binding StatusBadgeText}"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Compact Pipeline Chevron Connector -->
                            <TextBlock Grid.Column="1"
                                       Classes="stage-chevron"
                                       Text="›"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource StudioConnectorBrush}"
                                       Margin="3,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
