<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LeiterWatercolorStudio.App.Controls"
             xmlns:vm="using:LeiterWatercolorStudio.App.ViewModels"
             x:Class="LeiterWatercolorStudio.App.Controls.PipelineFilmstrip"
             x:Name="Root"
             x:DataType="controls:PipelineFilmstrip">

    <UserControl.Styles>
        <!-- Sub-stage pill button styles -->
        <Style Selector="Button.substage-pill">
            <Setter Property="Background" Value="#212836" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#313B4F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.substage-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A3345" />
            <Setter Property="BorderBrush" Value="#4B5B78" />
        </Style>
        <Style Selector="Button.substage-pill.bypassed">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.substage-pill.stale">
            <Setter Property="BorderBrush" Value="#B45309" />
        </Style>
        <Style Selector="Button.substage-pill.cached">
            <Setter Property="BorderBrush" Value="#047857" />
        </Style>
        <Style Selector="Button.substage-pill.running">
            <Setter Property="BorderBrush" Value="#0284C7" />
        </Style>
        <Style Selector="Button.substage-pill.selected">
            <Setter Property="Background" Value="#1E3A5F" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>
        <Style Selector="Button.substage-pill.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#244672" />
            <Setter Property="BorderBrush" Value="#7DD3FC" />
        </Style>

        <!-- Primary stage card styles -->
        <Style Selector="Border.stage-card">
            <Setter Property="Background" Value="#1A202B" />
            <Setter Property="BorderBrush" Value="#2D3648" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.stage-card:pointerover">
            <Setter Property="Background" Value="#202836" />
            <Setter Property="BorderBrush" Value="#475569" />
        </Style>
        <Style Selector="Border.stage-card.bypassed">
            <Setter Property="Background" Value="#151922" />
            <Setter Property="BorderBrush" Value="#262D3B" />
        </Style>
        <Style Selector="Border.stage-card.bypassed Border.thumb-frame">
            <Setter Property="Opacity" Value="0.48" />
        </Style>
        <Style Selector="Border.stage-card.cached">
            <Setter Property="BorderBrush" Value="#059669" />
        </Style>
        <Style Selector="Border.stage-card.stale">
            <Setter Property="BorderBrush" Value="#D97706" />
        </Style>
        <Style Selector="Border.stage-card.running">
            <Setter Property="Background" Value="#19283B" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
        </Style>
        <Style Selector="Border.stage-card.selected">
            <Setter Property="Background" Value="#1D2E46" />
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.stage-card.selected:pointerover">
            <Setter Property="BorderBrush" Value="#93C5FD" />
        </Style>

        <!-- Status dots (priority: idle -> bypassed -> cached -> stale -> running) -->
        <Style Selector="Ellipse.status-dot">
            <Setter Property="Fill" Value="#64748B" />
        </Style>
        <Style Selector=".bypassed Ellipse.status-dot">
            <Setter Property="Fill" Value="#6B7280" />
        </Style>
        <Style Selector=".cached Ellipse.status-dot">
            <Setter Property="Fill" Value="#10B981" />
        </Style>
        <Style Selector=".stale Ellipse.status-dot">
            <Setter Property="Fill" Value="#F59E0B" />
        </Style>
        <Style Selector=".running Ellipse.status-dot">
            <Setter Property="Fill" Value="#38BDF8" />
        </Style>

        <!-- Status badge pills -->
        <Style Selector="Border.status-pill">
            <Setter Property="Background" Value="#263042" />
        </Style>
        <Style Selector="Border.status-pill TextBlock.status-pill-text">
            <Setter Property="Foreground" Value="#CBD5E1" />
        </Style>
        <Style Selector=".bypassed Border.status-pill">
            <Setter Property="Background" Value="#272C36" />
        </Style>
        <Style Selector=".bypassed Border.status-pill TextBlock.status-pill-text">
            <Setter Property="Foreground" Value="#9CA3AF" />
        </Style>
        <Style Selector=".cached Border.status-pill">
            <Setter Property="Background" Value="#064E3B" />
        </Style>
        <Style Selector=".cached Border.status-pill TextBlock.status-pill-text">
            <Setter Property="Foreground" Value="#6EE7B7" />
        </Style>
        <Style Selector=".stale Border.status-pill">
            <Setter Property="Background" Value="#451A03" />
        </Style>
        <Style Selector=".stale Border.status-pill TextBlock.status-pill-text">
            <Setter Property="Foreground" Value="#FCD34D" />
        </Style>
        <Style Selector=".running Border.status-pill">
            <Setter Property="Background" Value="#0C4A6E" />
        </Style>
        <Style Selector=".running Border.status-pill TextBlock.status-pill-text">
            <Setter Property="Foreground" Value="#7DD3FC" />
        </Style>

        <!-- Pin button -->
        <Style Selector="Button.pin-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Opacity" Value="0.28" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.stage-card:pointerover Button.pin-btn">
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style Selector="Button.pin-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A3447" />
        </Style>
        <Style Selector="Button.pin-btn Path.pin-glyph">
            <Setter Property="Fill" Value="#94A3B8" />
        </Style>
        <Style Selector="Button.pin-btn.pinned">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="#3B2F13" />
        </Style>
        <Style Selector="Button.pin-btn.pinned Path.pin-glyph">
            <Setter Property="Fill" Value="#FBBF24" />
        </Style>

        <!-- Hide trailing chevron after the final stage card -->
        <Style Selector="ItemsControl#PrimaryStagesItemsControl ContentPresenter:nth-last-child(1) TextBlock.stage-chevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Border Background="#131720"
            BorderBrush="#252C3A"
            BorderThickness="0,1,0,0"
            Padding="10,8">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
            <!-- Collapsible Sub-Stage Drawer -->
            <Border Grid.Row="0"
                    IsVisible="{Binding #Root.ShowSubStageDrawer}"
                    Background="#181E29"
                    BorderBrush="#293244"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,5">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0"
                               Text="SUB-STAGES"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               VerticalAlignment="Center"
                               Margin="2,0,10,0" />
                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SubStagesItemsControl"
                                      ItemsSource="{Binding #Root.SubStages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SubStageItemViewModel">
                                    <Button Classes="substage-pill"
                                            Classes.selected="{Binding IsSelected}"
                                            Classes.running="{Binding IsRunning}"
                                            Classes.stale="{Binding IsStale}"
                                            Classes.cached="{Binding IsFromCache}"
                                            Classes.bypassed="{Binding IsBypassed}"
                                            Click="OnSubStageClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Classes="status-dot" Width="7" Height="7" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11.5"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#151B25"
                                                    CornerRadius="8"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimingText}"
                                                           FontSize="10"
                                                           Foreground="#94A3B8" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Primary 8-Stage Filmstrip -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PrimaryStagesItemsControl"
                              ItemsSource="{Binding #Root.Stages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StageCardViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                <Border Classes="stage-card"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.running="{Binding IsRunning}"
                                        Classes.stale="{Binding IsStale}"
                                        Classes.cached="{Binding IsFromCache}"
                                        Classes.bypassed="{Binding IsBypassed}"
                                        Classes.pinned="{Binding IsPinned}"
                                        Width="138"
                                        CornerRadius="8"
                                        Padding="6"
                                        Cursor="Hand"
                                        Focusable="True"
                                        PointerPressed="OnStageCardPointerPressed">
                                    <Grid RowDefinitions="Auto,66,Auto" RowSpacing="5">
                                        <!-- Card Header -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                                            <Border Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    CornerRadius="4"
                                                    Background="#262E3E"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ShortcutText}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#CBD5E1"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E2E8F0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="▾"
                                                       IsVisible="{Binding HasSubStages}"
                                                       FontSize="11"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="3"
                                                    Classes="pin-btn"
                                                    Classes.pinned="{Binding IsPinned}"
                                                    Click="OnPinButtonClick"
                                                    ToolTip.Tip="Pin stage for A/B comparison">
                                                <Path Classes="pin-glyph"
                                                      Width="10"
                                                      Height="10"
                                                      Stretch="Uniform"
                                                      Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" />
                                            </Button>
                                            <Ellipse Grid.Column="4"
                                                     Classes="status-dot"
                                                     Width="7"
                                                     Height="7"
                                                     VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Live Thumbnail Preview -->
                                        <Border Grid.Row="1"
                                                Classes="thumb-frame"
                                                Background="#0D1118"
                                                BorderBrush="#232B3A"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                ClipToBounds="True">
                                            <Panel>
                                                <TextBlock Text="—"
                                                           IsVisible="{Binding !HasThumbnail}"
                                                           FontSize="12"
                                                           Foreground="#475569"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Classes="stage-thumb"
                                                       Source="{Binding Thumbnail}"
                                                       IsVisible="{Binding HasThumbnail}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Panel>
                                        </Border>

                                        <!-- Card Footer -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimingText}"
                                                       FontSize="10.5"
                                                       Foreground="#94A3B8"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Classes="status-pill"
                                                    IsVisible="{Binding HasStatusBadge}"
                                                    CornerRadius="4"
                                                    Padding="4,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="status-pill-text"
                                                           Text="{Binding StatusBadgeText}"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Pipeline Chevron Connector -->
                                <TextBlock Classes="stage-chevron"
                                           Text="→"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="4,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
