<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:LeiterWatercolorStudio.App.Views"
             xmlns:vm="using:LeiterWatercolorStudio.App.ViewModels"
             x:Class="LeiterWatercolorStudio.App.Views.StageGridView"
             x:Name="Root"
             x:DataType="views:StageGridView">

    <UserControl.Styles>
        <!-- Grid tile card styles -->
        <Style Selector="Border.grid-tile">
            <Setter Property="Background" Value="#171C26" />
            <Setter Property="BorderBrush" Value="#2A3242" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.grid-tile:pointerover">
            <Setter Property="BorderBrush" Value="#475569" />
        </Style>
        <Style Selector="Border.grid-tile.bypassed">
            <Setter Property="BorderBrush" Value="#252B38" />
        </Style>
        <Style Selector="Border.grid-tile.bypassed Border.tile-viewport">
            <Setter Property="Opacity" Value="0.48" />
        </Style>
        <Style Selector="Border.grid-tile.cached">
            <Setter Property="BorderBrush" Value="#059669" />
        </Style>
        <Style Selector="Border.grid-tile.stale">
            <Setter Property="BorderBrush" Value="#D97706" />
        </Style>
        <Style Selector="Border.grid-tile.running">
            <Setter Property="BorderBrush" Value="#38BDF8" />
        </Style>
        <Style Selector="Border.grid-tile.selected">
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.grid-tile.selected:pointerover">
            <Setter Property="BorderBrush" Value="#93C5FD" />
        </Style>

        <!-- Status dots -->
        <Style Selector="Ellipse.status-dot">
            <Setter Property="Fill" Value="#64748B" />
        </Style>
        <Style Selector=".bypassed Ellipse.status-dot">
            <Setter Property="Fill" Value="#6B7280" />
        </Style>
        <Style Selector=".cached Ellipse.status-dot">
            <Setter Property="Fill" Value="#10B981" />
        </Style>
        <Style Selector=".stale Ellipse.status-dot">
            <Setter Property="Fill" Value="#F59E0B" />
        </Style>
        <Style Selector=".running Ellipse.status-dot">
            <Setter Property="Fill" Value="#38BDF8" />
        </Style>

        <!-- Reset button hover -->
        <Style Selector="Button.grid-toolbar-btn">
            <Setter Property="Background" Value="#232B3A" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.grid-toolbar-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2E384B" />
            <Setter Property="BorderBrush" Value="#475569" />
        </Style>
    </UserControl.Styles>

    <Border Background="#11151C">
        <Grid RowDefinitions="Auto,*">
            <!-- Synchronized Grid Header Toolbar -->
            <Border Grid.Row="0"
                    Background="#161B24"
                    BorderBrush="#252C38"
                    BorderThickness="0,0,0,1"
                    Padding="12,6">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="ALL STAGES (4×2)"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="• Scroll any tile to zoom, drag to pan in lockstep, double-click to inspect"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <Border Background="#1E2532"
                                BorderBrush="#2D3748"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding #Root.ZoomText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#CBD5E1" />
                        </Border>
                        <Button Classes="grid-toolbar-btn"
                                Content="Reset View"
                                Click="OnResetViewClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4x2 Multi-Up Stage Grid -->
            <ItemsControl x:Name="GridItemsControl"
                          Grid.Row="1"
                          ItemsSource="{Binding #Root.Stages}"
                          Margin="7">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StageCardViewModel">
                        <Border Classes="grid-tile"
                                Classes.selected="{Binding IsSelected}"
                                Classes.running="{Binding IsRunning}"
                                Classes.stale="{Binding IsStale}"
                                Classes.cached="{Binding IsFromCache}"
                                Classes.bypassed="{Binding IsBypassed}"
                                Margin="5"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Cursor="Hand"
                                PointerPressed="OnTilePointerPressed"
                                PointerMoved="OnTilePointerMoved"
                                PointerReleased="OnTilePointerReleased"
                                PointerCaptureLost="OnTilePointerCaptureLost"
                                PointerWheelChanged="OnTilePointerWheelChanged"
                                DoubleTapped="OnTileDoubleTapped">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Tile Header -->
                                <Border Grid.Row="0"
                                        Background="#1C222E"
                                        BorderBrush="#273041"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,5">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                        <!-- Shortcut Key Badge -->
                                        <Border Grid.Column="0"
                                                Width="17"
                                                Height="17"
                                                CornerRadius="4"
                                                Background="#273042"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortcutText}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#E2E8F0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Title -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F1F5F9"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <!-- Status Badges & Pin -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Ellipse Classes="status-dot"
                                                     Width="7"
                                                     Height="7"
                                                     VerticalAlignment="Center" />
                                            <Border Background="#0C4A6E"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    IsVisible="{Binding IsRunning}">
                                                <TextBlock Text="Running"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#7DD3FC" />
                                            </Border>
                                            <Border Background="#451A03"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    IsVisible="{Binding IsStale}">
                                                <TextBlock Text="Stale"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FCD34D" />
                                            </Border>
                                            <Border Background="#064E3B"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    IsVisible="{Binding IsFromCache}">
                                                <TextBlock Text="Cached"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#6EE7B7" />
                                            </Border>
                                            <Border Background="#272C36"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    IsVisible="{Binding IsBypassed}">
                                                <TextBlock Text="Bypassed"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#9CA3AF" />
                                            </Border>
                                            <Border Background="#3B2F13"
                                                    CornerRadius="4"
                                                    Padding="4,2"
                                                    IsVisible="{Binding IsPinned}"
                                                    ToolTip.Tip="Pinned for A/B compare">
                                                <Path Fill="#FBBF24"
                                                      Width="9"
                                                      Height="9"
                                                      Stretch="Uniform"
                                                      Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Timing Readout -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TimingText}"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Clipped Synchronized Transform Viewport -->
                                <Border Grid.Row="1"
                                        Classes="tile-viewport"
                                        Background="#0D1016"
                                        ClipToBounds="True">
                                    <Panel>
                                        <TextBlock Text="No Preview"
                                                   IsVisible="{Binding !HasDisplayBitmap}"
                                                   FontSize="11"
                                                   Foreground="#475569"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Classes="tile-image"
                                               Source="{Binding DisplayBitmap}"
                                               IsVisible="{Binding HasDisplayBitmap}"
                                               Stretch="Uniform"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="{Binding $parent[views:StageGridView].Zoom}"
                                                                    ScaleY="{Binding $parent[views:StageGridView].Zoom}" />
                                                    <TranslateTransform X="{Binding $parent[views:StageGridView].PanX}"
                                                                        Y="{Binding $parent[views:StageGridView].PanY}" />
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Panel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
