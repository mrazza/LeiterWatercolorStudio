<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:LeiterWatercolorStudio.App.Views"
             xmlns:vm="using:LeiterWatercolorStudio.App.ViewModels"
             x:Class="LeiterWatercolorStudio.App.Views.StageGridView"
             x:Name="Root"
             x:DataType="views:StageGridView">

    <UserControl.Styles>
        <!-- Grid tile card styles -->
        <Style Selector="Border.grid-tile">
            <Setter Property="Background" Value="{DynamicResource StudioGridTileBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioGridTileBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.grid-tile:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioMutedBrush}" />
        </Style>
        <Style Selector="Border.grid-tile.bypassed">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        </Style>
        <Style Selector="Border.grid-tile.bypassed Border.tile-viewport">
            <Setter Property="Opacity" Value="0.48" />
        </Style>
        <Style Selector="Border.grid-tile.cached">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioCachedBrush}" />
        </Style>
        <Style Selector="Border.grid-tile.stale">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioStaleBrush}" />
        </Style>
        <Style Selector="Border.grid-tile.running">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioStatusRunningBorderBrush}" />
        </Style>
        <Style Selector="Border.grid-tile.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.grid-tile.selected:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentHoverBrush}" />
        </Style>

        <!-- Status dots -->
        <Style Selector="Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource StudioMutedBrush}" />
        </Style>
        <Style Selector=".bypassed Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource StudioStatusBypassedFgBrush}" />
        </Style>
        <Style Selector=".cached Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource StudioCachedBrush}" />
        </Style>
        <Style Selector=".stale Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource StudioStaleBrush}" />
        </Style>
        <Style Selector=".running Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource StudioStatusRunningBorderBrush}" />
        </Style>

        <!-- Clickable grid pin button -->
        <Style Selector="Button.grid-pin-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Opacity" Value="0.32" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.grid-tile:pointerover Button.grid-pin-btn">
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style Selector="Button.grid-pin-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioPinHoverBgBrush}" />
        </Style>
        <Style Selector="Button.grid-pin-btn Path.pin-glyph">
            <Setter Property="Fill" Value="{DynamicResource StudioMutedBrush}" />
        </Style>
        <Style Selector="Button.grid-pin-btn.pinned">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource StudioPinPinnedBgBrush}" />
        </Style>
        <Style Selector="Button.grid-pin-btn.pinned Path.pin-glyph">
            <Setter Property="Fill" Value="{DynamicResource StudioPinPinnedFgBrush}" />
        </Style>

        <!-- Reset button hover -->
        <Style Selector="Button.grid-toolbar-btn">
            <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.grid-toolbar-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource StudioGridBgBrush}">
        <Grid RowDefinitions="Auto,*">
            <!-- Synchronized Grid Header Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource StudioGridHeaderBgBrush}"
                    BorderBrush="{DynamicResource StudioGridHeaderBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="ALL STAGES (4×2)"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource StudioSecondaryForegroundBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="• Scroll any tile to zoom, drag to pan in lockstep, double-click to inspect"
                                   FontSize="11"
                                   Foreground="{DynamicResource StudioMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <Border Background="{DynamicResource StudioSurfaceAltBrush}"
                                BorderBrush="{DynamicResource StudioBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding #Root.ZoomText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource StudioSecondaryForegroundBrush}" />
                        </Border>
                        <Button Classes="grid-toolbar-btn"
                                Content="Reset View"
                                ToolTip.Tip="Fit all 8 tiles to view (Ctrl+0 / Ctrl+1)"
                                Click="OnResetViewClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4x2 Multi-Up Stage Grid -->
            <ItemsControl x:Name="GridItemsControl"
                          Grid.Row="1"
                          ItemsSource="{Binding #Root.Stages}"
                          Margin="7">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StageCardViewModel">
                        <Border Classes="grid-tile"
                                Classes.selected="{Binding IsSelected}"
                                Classes.running="{Binding IsRunning}"
                                Classes.stale="{Binding IsStale}"
                                Classes.cached="{Binding IsFromCache}"
                                Classes.bypassed="{Binding IsBypassed}"
                                Margin="5"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Cursor="Hand"
                                PointerPressed="OnTilePointerPressed"
                                PointerMoved="OnTilePointerMoved"
                                PointerReleased="OnTilePointerReleased"
                                PointerCaptureLost="OnTilePointerCaptureLost"
                                PointerWheelChanged="OnTilePointerWheelChanged"
                                DoubleTapped="OnTileDoubleTapped">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Tile Header -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource StudioGridTileHeaderBgBrush}"
                                        BorderBrush="{DynamicResource StudioGridTileBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,5">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                        <!-- Shortcut Key Badge -->
                                        <Border Grid.Column="0"
                                                Width="17"
                                                Height="17"
                                                CornerRadius="4"
                                                Background="{DynamicResource StudioSurfaceAltBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortcutText}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource StudioSecondaryForegroundBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Title -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StudioForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <!-- Status Badges & Clickable Pin -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Ellipse Classes="status-dot"
                                                     Width="7"
                                                     Height="7"
                                                     VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource StudioStatusRunningBgBrush}"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    IsVisible="{Binding IsRunning}">
                                                <TextBlock Text="Running"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource StudioStatusRunningFgBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource StudioStatusStaleBgBrush}"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    IsVisible="{Binding IsStale}">
                                                <TextBlock Text="Stale"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource StudioStatusStaleFgBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource StudioStatusCachedBgBrush}"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    IsVisible="{Binding IsFromCache}">
                                                <TextBlock Text="Cached"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource StudioStatusCachedFgBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource StudioStatusBypassedBgBrush}"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    IsVisible="{Binding IsBypassed}">
                                                <TextBlock Text="Bypassed"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource StudioStatusBypassedFgBrush}" />
                                            </Border>
                                            <Button Classes="grid-pin-btn"
                                                    Classes.pinned="{Binding IsPinned}"
                                                    Click="OnPinButtonClick"
                                                    ToolTip.Tip="Pin or unpin stage for A/B comparison">
                                                <Path Classes="pin-glyph"
                                                      Width="9"
                                                      Height="9"
                                                      Stretch="Uniform"
                                                      Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Timing Readout -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TimingText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource StudioMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Clipped Synchronized Transform Viewport -->
                                <Border Grid.Row="1"
                                        Classes="tile-viewport"
                                        Background="{DynamicResource StudioGridTileViewportBgBrush}"
                                        ClipToBounds="True">
                                    <Panel>
                                        <TextBlock Text="No Preview"
                                                   IsVisible="{Binding !HasDisplayBitmap}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource StudioMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Classes="tile-image"
                                               Source="{Binding DisplayBitmap}"
                                               IsVisible="{Binding HasDisplayBitmap}"
                                               Stretch="Uniform"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="{Binding $parent[views:StageGridView].Zoom}"
                                                                    ScaleY="{Binding $parent[views:StageGridView].Zoom}" />
                                                    <TranslateTransform X="{Binding $parent[views:StageGridView].PanX}"
                                                                        Y="{Binding $parent[views:StageGridView].PanY}" />
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Panel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
