<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LeiterWatercolorStudio.App.Views.Inspectors"
             xmlns:controls="using:LeiterWatercolorStudio.App.Controls"
             xmlns:converters="using:LeiterWatercolorStudio.App.Converters"
             xmlns:stages="clr-namespace:LeiterWatercolorStudio.Core.Parameters.Stages;assembly=LeiterWatercolorStudio.Core"
             xmlns:ldata="clr-namespace:Leiter.Algorithms.DataStructures;assembly=Leiter"
             x:Class="LeiterWatercolorStudio.App.Views.Inspectors.SegmentationInspectorView"
             x:DataType="stages:SegmentationStageViewModel">

    <UserControl.Styles>
        <Style Selector="Border.inspector-card">
            <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,9" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="12">
            <!-- Live Segmentation Statistics Readout -->
            <Border Classes="inspector-card">
                <StackPanel Spacing="4">
                    <TextBlock Classes="section-title" Text="SEGMENTATION STATS" />
                    <TextBlock x:Name="PART_StatsText"
                               x:DataType="local:SegmentationInspectorView"
                               Text="{Binding StatsText, RelativeSource={RelativeSource AncestorType=local:SegmentationInspectorView}, TargetNullValue='Run pipeline to view region statistics'}"
                               FontSize="12"
                               FontWeight="Medium"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Basic Tier Parameters -->
            <StackPanel Spacing="8">
                <controls:NumericSlider Label="Spatial Radius"
                                        Description="Spatial search window radius in pixels for Mean-Shift filtering."
                                        InfoText="Sets how wide a neighborhood each brushstroke considers when grouping pixels into clean color washes. Small values trace crisp small features in Mean-Shift Filtered and Mean-Shift Regions; large values simplify the scene into broad, relaxed paint blobs that shape Wet-in-Wet and Hand Tremor edges."
                                        Minimum="1"
                                        Maximum="32"
                                        ValidMinimum="1"
                                        Step="1"
                                        IsInteger="True"
                                        FormatString="F0"
                                        Unit="px"
                                        BaselineValue="{Binding Baseline.SpatialRadius, Converter={x:Static converters:IntToDoubleConverter.Instance}}"
                                        Value="{Binding SpatialRadius, Mode=TwoWay, Converter={x:Static converters:IntToDoubleConverter.Instance}}" />

                <controls:NumericSlider Label="Range Radius"
                                        Description="CIELAB color distance window radius controlling region color similarity."
                                        InfoText="Controls how different two colors can be before Mean-Shift splits them into separate painted shapes. Low values preserve subtle shading bands and many regions; high values merge close tones into flat, bold blocks in Mean-Shift Filtered, Mean-Shift Regions, and the final painting."
                                        Minimum="0.5"
                                        Maximum="30"
                                        ValidMinimum="0"
                                        IsValidMinimumExclusive="True"
                                        Step="0.5"
                                        FormatString="F1"
                                        BaselineValue="{Binding Baseline.RangeRadius}"
                                        Value="{Binding RangeRadius, Mode=TwoWay}" />

                <controls:NumericSlider Label="Min Region Size"
                                        Description="Minimum pixel count per segmented region before small-region merging."
                                        InfoText="Eliminates tiny paint specks in Mean-Shift Regions by folding any region smaller than this size into its nearest neighbor. Higher values create simpler, less cluttered wash shapes with fewer noisy paper gaps or edge rings in later stages."
                                        Minimum="0"
                                        Maximum="2000"
                                        ValidMinimum="0"
                                        Step="10"
                                        IsInteger="True"
                                        FormatString="F0"
                                        Unit="px"
                                        BaselineValue="{Binding Baseline.MinRegionSize, Converter={x:Static converters:IntToDoubleConverter.Instance}}"
                                        Value="{Binding MinRegionSize, Mode=TwoWay, Converter={x:Static converters:IntToDoubleConverter.Instance}}" />
            </StackPanel>

            <!-- Advanced Expander -->
            <Expander x:Name="PART_AdvancedExpander"
                      Header="Advanced"
                      HorizontalAlignment="Stretch"
                      IsExpanded="False">
                <StackPanel Spacing="8" Margin="0,6,0,0">
                    <controls:NumericSlider Label="Max Iterations"
                                            Description="Maximum Mean-Shift mode-seeking iterations per pixel."
                                            InfoText="Caps how many steps pixels take to settle onto their region color in Mean-Shift Filtered. Very low numbers give a looser, softly blended look; raising it sharpens flat region interiors before plateauing once pixels finish settling."
                                            Minimum="1"
                                            Maximum="50"
                                            ValidMinimum="1"
                                            Step="1"
                                            IsInteger="True"
                                            FormatString="F0"
                                            BaselineValue="{Binding Baseline.MaxIterations, Converter={x:Static converters:IntToDoubleConverter.Instance}}"
                                            Value="{Binding MaxIterations, Mode=TwoWay, Converter={x:Static converters:IntToDoubleConverter.Instance}}" />

                    <controls:NumericSlider Label="Convergence Epsilon"
                                            Description="5D spatial-range convergence threshold halting iteration."
                                            InfoText="Controls how early Mean-Shift stops refining each pixel's color. Smaller values run slightly longer for crisp, flat color plateaus in Mean-Shift Filtered; larger values stop sooner for a gently softer, faster pass."
                                            Minimum="0.001"
                                            Maximum="1.0"
                                            ValidMinimum="0"
                                            IsValidMinimumExclusive="True"
                                            Step="0.005"
                                            FormatString="F3"
                                            BaselineValue="{Binding Baseline.ConvergenceEpsilon}"
                                            Value="{Binding ConvergenceEpsilon, Mode=TwoWay}" />

                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Connectivity"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Grid pixel neighborhood connectivity (4-connected vs 8-connected) used for region clustering and merging" />
                            <controls:SettingInfoIcon Header="Segmentation Connectivity"
                                                      Text="Controls whether diagonally touching pixels of the same tone link into one wash shape in Mean-Shift Regions. 8-Connected connects thin diagonal strokes together; 4-Connected keeps diagonals separate, affecting where Wet-in-Wet bleeds and Hand Tremor gaps form." />
                        </StackPanel>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static local:SegmentationInspectorView.GridConnectivities}"
                                  SelectedItem="{Binding Connectivity, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ldata:GridConnectivity">
                                    <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
