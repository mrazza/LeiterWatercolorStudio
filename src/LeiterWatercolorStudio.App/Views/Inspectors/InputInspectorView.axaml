<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LeiterWatercolorStudio.App.Views.Inspectors"
             xmlns:vm="using:LeiterWatercolorStudio.App.ViewModels"
             x:Class="LeiterWatercolorStudio.App.Views.Inspectors.InputInspectorView"
             x:Name="Root"
             x:DataType="local:InputInspectorView">

    <UserControl.Styles>
        <Style Selector="Border.inspector-card">
            <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,9" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.meta-label">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Opacity" Value="0.68" />
        </Style>
        <Style Selector="TextBlock.meta-value">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="12">
            <!-- Empty State Hint -->
            <Border Classes="inspector-card"
                    IsVisible="{Binding !#Root.HasImage}">
                <TextBlock Text="No source image loaded. Open an image or drag and drop a file onto the viewport to start watercolorization."
                           FontSize="11.5"
                           Opacity="0.82"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Image Metadata Card -->
            <Border Classes="inspector-card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="SOURCE IMAGE" />

                    <StackPanel Spacing="2">
                        <TextBlock Classes="meta-label" Text="File Path" />
                        <TextBlock x:Name="PART_SourcePathText"
                                   Classes="meta-value"
                                   Text="{Binding #Root.SourcePathText}"
                                   ToolTip.Tip="{Binding #Root.SourcePathText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="meta-label" Text="Native Size" />
                        <TextBlock x:Name="PART_NativeDimensionsText"
                                   Grid.Row="0" Grid.Column="1"
                                   Classes="meta-value"
                                   HorizontalAlignment="Right"
                                   Text="{Binding #Root.NativeDimensionsText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="meta-label" Text="Preview Size" />
                        <TextBlock x:Name="PART_PreviewDimensionsText"
                                   Grid.Row="1" Grid.Column="1"
                                   Classes="meta-value"
                                   HorizontalAlignment="Right"
                                   Text="{Binding #Root.PreviewDimensionsText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Pipeline Summary Card -->
            <Border Classes="inspector-card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="ACTIVE CONFIGURATION" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="meta-label" Text="Baseline" VerticalAlignment="Top" />
                        <TextBlock x:Name="PART_BaselineSummaryText"
                                   Grid.Row="0" Grid.Column="1"
                                   Classes="meta-value"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Text="{Binding #Root.BaselineSummaryText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="meta-label" Text="Palette" VerticalAlignment="Top" />
                        <TextBlock x:Name="PART_PaletteSummaryText"
                                   Grid.Row="1" Grid.Column="1"
                                   Classes="meta-value"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Text="{Binding #Root.PaletteSummaryText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Artist Look Shortcuts -->
            <Border Classes="studio-card"
                    x:DataType="vm:MainWindowViewModel">
                <StackPanel Spacing="7">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="section-title" Text="ARTIST LOOK SHORTCUTS" />
                        <TextBlock Text="Jump straight to the stage controls behind common artistic goals."
                                   FontSize="11"
                                   Opacity="0.68"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="studio-chip"
                                Margin="0,0,5,5"
                                Content="Looser Wash"
                                Command="{Binding ApplyLookShortcutCommand}"
                                CommandParameter="looser-wash"
                                ToolTip.Tip="Stage 5 (LOD Abstraction): broaden non-salient washes and distance smoothing" />

                        <Button Classes="studio-chip"
                                Margin="0,0,5,5"
                                Content="Paper Tooth"
                                Command="{Binding ApplyLookShortcutCommand}"
                                CommandParameter="paper-tooth"
                                ToolTip.Tip="Stage 8 (Finishing → Paper Granulation): tune pigment settling and fiber micro-warp" />

                        <Button Classes="studio-chip"
                                Margin="0,0,5,5"
                                Content="Crisper Edges"
                                Command="{Binding ApplyLookShortcutCommand}"
                                CommandParameter="crisper-edges"
                                ToolTip.Tip="Stage 8 (Finishing → Edge Darkening): sharpen dried pigment rims along wash borders" />

                        <Button Classes="studio-chip"
                                Margin="0,0,5,5"
                                Content="Richer Color"
                                Command="{Binding ApplyLookShortcutCommand}"
                                CommandParameter="richer-color"
                                ToolTip.Tip="Stage 2 (Color Transfer): choose a watercolor palette or boost transfer strength" />

                        <Button Classes="studio-chip"
                                Margin="0,0,5,5"
                                Content="Focus Subject"
                                Command="{Binding ApplyLookShortcutCommand}"
                                CommandParameter="focus-subject"
                                ToolTip.Tip="Stage 3 (Saliency): refine RC saliency map, SaliencyCut mask, and distance falloff" />

                        <Button Classes="studio-chip"
                                Margin="0,0,5,5"
                                Content="Paper Gaps"
                                Command="{Binding ApplyLookShortcutCommand}"
                                CommandParameter="paper-gaps"
                                ToolTip.Tip="Stage 7 (Hand Tremor): adjust edge wobble, paper gap bias, and paper color" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <StackPanel Spacing="6">
                <TextBlock Classes="section-title" Text="QUICK ACTIONS" />

                <Button x:Name="PART_OpenImageButton"
                        Classes="studio-btn"
                        Content="Open Image..."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="10,7"
                        Command="{Binding #Root.OpenImageCommand}" />

                <StackPanel Spacing="6" IsEnabled="{Binding #Root.HasImage}">
                    <Button x:Name="PART_RenderFullResButton"
                            Classes="studio-btn"
                            Content="Render Full Resolution"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="10,7"
                            Command="{Binding #Root.RenderFullResCommand}" />

                    <Button x:Name="PART_ExportFinalButton"
                            Classes="studio-btn"
                            Content="Export Final Image..."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="10,7"
                            Command="{Binding #Root.ExportFinalCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
