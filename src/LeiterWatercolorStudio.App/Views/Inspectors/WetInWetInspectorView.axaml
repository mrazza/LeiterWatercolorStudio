<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LeiterWatercolorStudio.App.Controls"
             xmlns:converters="using:LeiterWatercolorStudio.App.Converters"
             xmlns:local="using:LeiterWatercolorStudio.App.Views.Inspectors"
             xmlns:stages="clr-namespace:LeiterWatercolorStudio.Core.Parameters.Stages;assembly=LeiterWatercolorStudio.Core"
             xmlns:watercolor="clr-namespace:Leiter.Algorithms.Stylization.Watercolor;assembly=Leiter"
             x:Class="LeiterWatercolorStudio.App.Views.Inspectors.WetInWetInspectorView"
             x:DataType="stages:WetInWetStageViewModel">
    <UserControl.Styles>
        <Style Selector="Border.inspector-card">
            <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Border.stats-pill">
            <Setter Property="Background" Value="{DynamicResource StudioSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioPillActiveBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12"
                    Spacing="10"
                    IsEnabled="{Binding IsWetInWetActive}"
                    Opacity="{Binding IsWetInWetActive, Converter={x:Static converters:BoolToOpacityConverter.Instance}}">
            <!-- Basic Tier -->
            <Border Classes="inspector-card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="BASIC" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="3"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Mode"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Boundary saliency filtering policy controlling where wet-in-wet bleeding is allowed" />
                            <controls:SettingInfoIcon Header="Wet-in-Wet Mode"
                                                      Text="Picks which borders are allowed to bleed (visible in Qualifying Boundaries and Wet Area Mask). Default bleeds across all qualifying color borders; Exclude Salient Boundaries keeps a crisp halo between subject and background; Exclude Salient Regions prevents bleeding inside your main subject while softening edges and background." />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static stages:WetInWetStageViewModel.SelectableFilteringModes}"
                                  SelectedItem="{Binding Mode, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="watercolor:WetInWetMode">
                                    <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <controls:NumericSlider Label="Color Gradient Threshold"
                                            Description="Minimum region-averaged color gradient magnitude required to qualify a boundary"
                                            InfoText="Sets how strong the color jump across an edge must be before wet paint starts bleeding there. Low values let subtle shading edges bleed softly in Wet-in-Wet Image; higher values restrict bleeding strictly to bold, high-contrast borders shown in Qualifying Boundaries."
                                            Minimum="0"
                                            Maximum="1"
                                            ValidMinimum="0"
                                            Step="0.01"
                                            FormatString="F2"
                                            Value="{Binding ColorGradientThreshold, Mode=TwoWay}"
                                            BaselineValue="{Binding Baseline.ColorGradientThreshold}" />

                    <controls:NumericSlider Label="Scatter Radius"
                                            Description="Maximum pixel distance from qualifying boundaries for pigment seed scattering"
                                            InfoText="Sets how far wet pigment blossoms reach out from qualifying edges. Small values keep delicate, localized feathering in Wet Area Mask and Wet-in-Wet Image; larger values push longer, softer paint blooms outward across neighboring shapes."
                                            Unit="px"
                                            Minimum="1"
                                            Maximum="20"
                                            ValidMinimum="1"
                                            Step="1"
                                            IsInteger="True"
                                            FormatString="F0"
                                            Value="{Binding ScatterRadius, Mode=TwoWay, Converter={x:Static converters:IntToDoubleConverter.Instance}}"
                                            BaselineValue="{Binding Baseline.ScatterRadius, Converter={x:Static converters:IntToDoubleConverter.Instance}}" />

                    <controls:NumericSlider Label="Seed Probability"
                                            Description="Probability of depositing a pigment bleed seed at a candidate boundary pixel"
                                            InfoText="Controls how densely bleed droplets sprout along qualifying borders. Near 0 leaves only rare wispy tendrils in Wet Area Mask; raising toward 1 floods the entire qualifying rim with continuous wet feathering in Wet-in-Wet Image and the final painting."
                                            Minimum="0"
                                            Maximum="1"
                                            ValidMinimum="0"
                                            ValidMaximum="1"
                                            Step="0.01"
                                            FormatString="F2"
                                            Value="{Binding SeedProbability, Mode=TwoWay}"
                                            BaselineValue="{Binding Baseline.SeedProbability}" />

                    <Border Classes="stats-pill"
                            Margin="0,2,0,0"
                            IsVisible="{Binding StatsText, RelativeSource={RelativeSource AncestorType=local:WetInWetInspectorView}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding StatsText, RelativeSource={RelativeSource AncestorType=local:WetInWetInspectorView}}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Advanced Tier -->
            <Expander Header="Advanced"
                      IsExpanded="False"
                      HorizontalAlignment="Stretch"
                      Padding="10,8">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-label" Text="BOUNDARY FILTERING" />

                    <controls:NumericSlider Label="Salient Hue Threshold"
                                            Description="Maximum hue difference in degrees for qualifying boundaries incident to salient regions"
                                            InfoText="Limits how different two hues can be before blocking wet bleeding on borders touching the main subject. Low values only allow similar hues (like warm red into orange) to bleed on subjects so contrasting colors stay crisp; higher values let mismatched subject colors mix freely."
                                            Unit="°"
                                            Minimum="0"
                                            Maximum="180"
                                            ValidMinimum="0"
                                            ValidMaximum="180"
                                            Step="1"
                                            FormatString="F1"
                                            Value="{Binding SalientHueThresholdDegrees, Mode=TwoWay}"
                                            BaselineValue="{Binding Baseline.SalientHueThresholdDegrees}" />

                    <controls:NumericSlider Label="Non-Salient Hue Threshold"
                                            Description="Maximum hue difference in degrees for qualifying boundaries between non-salient regions"
                                            InfoText="Limits how different two hues can be before blocking wet bleeding between background regions. Lower values keep sharply clashing background colors cleanly separated; higher values encourage neighboring background washes to mingle smoothly."
                                            Unit="°"
                                            Minimum="0"
                                            Maximum="180"
                                            ValidMinimum="0"
                                            ValidMaximum="180"
                                            Step="1"
                                            FormatString="F1"
                                            Value="{Binding NonSalientHueThresholdDegrees, Mode=TwoWay}"
                                            BaselineValue="{Binding Baseline.NonSalientHueThresholdDegrees}" />

                    <controls:NumericSlider Label="Min Intensity Difference"
                                            Description="Minimum HSI intensity difference between adjacent regions required for bleeding"
                                            InfoText="Sets how much brightness difference two regions need before bleeding begins. Near 0 lets equally bright regions mingle freely; raising it restricts Wet Area Mask and soft feathering strictly to stronger light-versus-dark transitions."
                                            Minimum="0"
                                            Maximum="1"
                                            ValidMinimum="0"
                                            Step="0.005"
                                            FormatString="F3"
                                            Value="{Binding MinIntensityDifference, Mode=TwoWay}"
                                            BaselineValue="{Binding Baseline.MinIntensityDifference}" />

                    <controls:NumericSlider Label="Salient Overlap Threshold"
                                            Description="Minimum salient pixel fraction required to classify a segmented region as salient"
                                            InfoText="Determines how much of a painted region must sit inside SaliencyCut Mask before Wet-in-Wet treats it as part of the main subject for hue and mode filtering. Lower values protect borderline edges; higher values treat only core subject patches as salient."
                                            Minimum="0"
                                            Maximum="1"
                                            ValidMinimum="0"
                                            ValidMaximum="1"
                                            Step="0.01"
                                            FormatString="F2"
                                            Value="{Binding SalientOverlapThreshold, Mode=TwoWay}"
                                            BaselineValue="{Binding Baseline.SalientOverlapThreshold}" />

                    <!-- Seed Row -->
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*,Auto"
                          Margin="0,4,0,2">
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock Text="Seed"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Deterministic pseudo-random seed controlling pigment seed placement along qualifying boundaries" />
                            <controls:SettingInfoIcon Header="Wet-in-Wet Seed"
                                                      Text="Rearranges the random positions of wet-paint tendrils along borders in Wet Area Mask and Wet-in-Wet Image without changing overall bleed size or density. Click Random to try a different organic sprinkle pattern." />
                        </StackPanel>
                        <TextBox x:Name="PART_SeedTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 MinHeight="26"
                                 Height="26"
                                 Padding="6,2"
                                 FontSize="12"
                                 TextAlignment="Right"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Classes="studio-btn"
                                Content="🎲 Random"
                                Height="26"
                                MinHeight="26"
                                Padding="8,2"
                                FontSize="11.5"
                                Margin="6,0,0,0"
                                VerticalContentAlignment="Center"
                                Click="OnRandomizeSeedClick"
                                ToolTip.Tip="Generate a new random seed" />
                        <TextBlock x:Name="PART_SeedErrorText"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Classes="validation-error"
                                   IsVisible="False" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource StudioBorderBrush}" Margin="0,4,0,2" />
                    <TextBlock Classes="section-label" Text="ORIENTED ELLIPTICAL FILTER" />

                    <controls:NumericSlider Label="Major Radius"
                                            Description="Semi-major radius of the oriented elliptical Gaussian feathering filter"
                                            InfoText="Controls how far wet bleed feathers stretch parallel along the painted edge. Smaller values leave compact dots in Wet-in-Wet Image; larger values blend streaks smoothly along contours like water flowing along a brush border."
                                            Unit="px"
                                            Minimum="0.25"
                                            Maximum="24"
                                            ValidMinimum="0"
                                            IsValidMinimumExclusive="True"
                                            Step="0.25"
                                            FormatString="F2"
                                            Value="{Binding EllipticalMajorRadius, Mode=TwoWay}"
                                            BaselineValue="{Binding Baseline.EllipticalFilter.MajorRadius}" />

                    <controls:NumericSlider Label="Minor Radius"
                                            Description="Semi-minor radius perpendicular to the local boundary tangent"
                                            InfoText="Controls how soft and blurry the wet feathering spreads across the boundary width. Low values keep distinct speckled tendrils in Wet-in-Wet Image; higher values melt droplets into a wide, misty wash across the border."
                                            Unit="px"
                                            Minimum="0.25"
                                            Maximum="16"
                                            ValidMinimum="0"
                                            IsValidMinimumExclusive="True"
                                            Step="0.25"
                                            FormatString="F2"
                                            Value="{Binding EllipticalMinorRadius, Mode=TwoWay}"
                                            BaselineValue="{Binding Baseline.EllipticalFilter.MinorRadius}" />

                    <controls:NumericSlider Label="Sigma Scale"
                                            Description="Gaussian standard deviation scale factor relative to the elliptical radii"
                                            InfoText="Controls how gentle versus punchy the falloff inside each bleed droplet feels. Lower values concentrate pigment near the droplet center for crisp spots; higher values spread the blur evenly to the edge of the ellipse for a smooth haze."
                                            Minimum="0.1"
                                            Maximum="2.0"
                                            ValidMinimum="0"
                                            IsValidMinimumExclusive="True"
                                            Step="0.05"
                                            FormatString="F2"
                                            Value="{Binding EllipticalSigmaScale, Mode=TwoWay}"
                                            BaselineValue="{Binding Baseline.EllipticalFilter.SigmaScale}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
