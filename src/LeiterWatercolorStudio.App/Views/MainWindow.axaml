<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LeiterWatercolorStudio.App.ViewModels"
        xmlns:views="using:LeiterWatercolorStudio.App.Views"
        xmlns:inspectors="using:LeiterWatercolorStudio.App.Views.Inspectors"
        xmlns:controls="using:LeiterWatercolorStudio.App.Controls"
        xmlns:conv="using:LeiterWatercolorStudio.App.Converters"
        xmlns:models="using:LeiterWatercolorStudio.Core.Models"
        x:Class="LeiterWatercolorStudio.App.Views.MainWindow"
        x:Name="WindowRoot"
        x:DataType="vm:MainWindowViewModel"
        Title="Leiter Watercolor Studio"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="640"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource StudioCanvasBrush}"
        Foreground="{DynamicResource StudioForegroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Top Studio Toolbar (single row at 1440x900 across all Compare modes) -->
        <Border Grid.Row="0" Classes="studio-toolbar" Padding="6,5">
            <Grid ColumnDefinitions="*,Auto">
                <WrapPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <!-- File Open -->
                    <Button Classes="studio-accent"
                            Content="Open..."
                            Padding="9,4"
                            Command="{Binding OpenImageCommand}"
                            ToolTip.Tip="Open a source image (Ctrl+O)"
                            Margin="0,1,3,1" />

                    <Border Classes="toolbar-sep" Height="20" Margin="1,2,3,2" />

                    <!-- Preview Cap -->
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,1,4,1">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="studio-muted"
                                       Text="Preview"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Maximum dimension for interactive preview rendering" />
                            <controls:SettingInfoIcon Header="Preview Resolution"
                                                      Text="Sets how large the working preview renders while you drag sliders. Smaller caps update much faster, though fine details like paper tooth and thin bleeds appear crisper at larger caps. Full-Resolution renders and exports always use the full original photo size." />
                        </StackPanel>
                        <ComboBox Classes="studio-combo"
                                  MinWidth="68"
                                  Padding="5,3"
                                  ItemsSource="{Binding PreviewCapOptions}"
                                  SelectedItem="{Binding PreviewCap, Mode=TwoWay}"
                                  ToolTip.Tip="Maximum dimension for interactive preview rendering">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:PreviewResolutionCap">
                                    <TextBlock Text="{Binding ., Converter={x:Static conv:EnumDisplayNameConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Baseline Selector -->
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,1,4,1">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="studio-muted"
                                       Text="Baseline"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Calibration baseline for parameter defaults and resets" />
                            <controls:SettingInfoIcon Header="Baseline Mode"
                                                      Text="Chooses the starting point and reset target for all painting stages. Default uses standard reference values; For Size scales radii for your image size; For Image further tailors settings to your photo's visual clutter and contrast." />
                        </StackPanel>
                        <ComboBox Classes="studio-combo"
                                  MinWidth="80"
                                  Padding="5,3"
                                  ItemsSource="{Binding BaselineModeOptions}"
                                  SelectedItem="{Binding ActiveBaselineMode, Mode=TwoWay}"
                                  ToolTip.Tip="Calibration baseline for parameter defaults and resets">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:BaselineMode">
                                    <TextBlock Text="{Binding ., Converter={x:Static conv:EnumDisplayNameConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Border Classes="toolbar-sep" Height="20" Margin="1,2,3,2" />

                    <!-- Auto-Run / Run (Cancel lives in the viewport processing pill to prevent toolbar shift) -->
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,1,4,1">
                        <ToggleButton Classes="studio-toggle"
                                      Padding="6,4"
                                      IsChecked="{Binding IsAutoRunEnabled, Mode=TwoWay}"
                                      ToolTip.Tip="Toggle automatic debounced re-rendering on edits">
                            <Panel>
                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsAutoRunEnabled}">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource StudioCachedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Auto-Run" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsAutoRunEnabled}">
                                    <Path Width="9"
                                          Height="10"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource StudioStaleBrush}"
                                          VerticalAlignment="Center"
                                          Data="M6,19H10V5H6V19ZM14,5V19H18V5H14Z" />
                                    <TextBlock Text="Paused" VerticalAlignment="Center" />
                                </StackPanel>
                            </Panel>
                        </ToggleButton>

                        <Button Classes="studio-run-subtle"
                                Classes.studio-accent="{Binding IsRunHighlighted}"
                                Content="▶ Run"
                                Padding="7,4"
                                Command="{Binding RunNowCommand}"
                                ToolTip.Tip="Run pipeline now (Ctrl+Enter)" />
                    </StackPanel>

                    <Border Classes="toolbar-sep" Height="20" Margin="1,2,3,2" />

                    <!-- Compact Undo / Redo Icon Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,1,4,1">
                        <Button Classes="studio-icon-btn"
                                Command="{Binding UndoCommand}"
                                ToolTip.Tip="Undo last parameter edit (Ctrl+Z)">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource StudioForegroundBrush}"
                                  Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" />
                        </Button>
                        <Button Classes="studio-icon-btn"
                                Command="{Binding RedoCommand}"
                                ToolTip.Tip="Redo parameter edit (Ctrl+Y / Ctrl+Shift+Z)">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource StudioForegroundBrush}"
                                  Data="M18.4,10.6C16.55,9 14.15,8 11.5,8C6.85,8 2.92,11.03 1.54,15.22L3.9,16C4.95,12.81 7.95,10.5 11.5,10.5C13.45,10.5 15.23,11.22 16.62,12.38L13,16H22V7L18.4,10.6Z" />
                        </Button>
                    </StackPanel>

                    <Border Classes="toolbar-sep" Height="20" Margin="1,2,3,2" />

                    <!-- Compare Mode / Reference / Hold-to-Compare / Pin -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,1,4,1">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,2,0">
                            <TextBlock Classes="studio-muted"
                                       Text="Compare"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Viewport A/B comparison mode and reference source (C)" />
                            <controls:SettingInfoIcon Header="Compare Mode"
                                                      Text="Controls how the main canvas lets you inspect before-and-after changes using Split Wipe, Side-by-Side, or Hold-to-Compare (\) against the Input photo, Previous Stage, or a Pinned stage. This is purely a viewing aid and never alters the painted image." />
                        </StackPanel>
                        <ComboBox Classes="studio-combo"
                                  Width="106"
                                  Padding="5,3"
                                  ItemsSource="{Binding CompareModeOptions}"
                                  SelectedItem="{Binding CompareMode, Mode=TwoWay}"
                                  ToolTip.Tip="Viewport comparison mode (press C to toggle)">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CompareMode">
                                    <TextBlock Text="{Binding ., Converter={x:Static conv:EnumDisplayNameConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Classes="studio-combo"
                                  Width="112"
                                  Padding="5,3"
                                  ItemsSource="{Binding CompareReferenceOptions}"
                                  SelectedItem="{Binding CompareReferenceKind, Mode=TwoWay}"
                                  ToolTip.Tip="Comparison reference source">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CompareReferenceKind">
                                    <TextBlock Text="{Binding ., Converter={x:Static conv:EnumDisplayNameConverter.Instance}}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="HoldCompareButton"
                                Classes="studio-icon-btn"
                                IsEnabled="{Binding HasImage}"
                                ToolTip.Tip="Press and hold to view comparison reference (\)">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource StudioForegroundBrush}"
                                  Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z" />
                        </Button>
                        <ToggleButton Classes="studio-toggle"
                                      Width="28"
                                      Height="28"
                                      Padding="0"
                                      IsChecked="{Binding IsCurrentStagePinned, Mode=OneWay}"
                                      Command="{Binding PinCurrentStageCommand}"
                                      ToolTip.Tip="Pin or unpin the active stage as A/B comparison reference (P)">
                            <Path Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource StudioForegroundBrush}"
                                  Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" />
                        </ToggleButton>
                    </StackPanel>

                    <Border Classes="toolbar-sep" Height="20" Margin="1,2,3,2" />

                    <!-- Single | Grid View Mode -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,1,4,1">
                        <ToggleButton Classes="studio-toggle"
                                      Content="Single"
                                      Padding="6,4"
                                      IsChecked="{Binding !IsGridView, Mode=OneWay}"
                                      Click="OnSingleViewClick"
                                      ToolTip.Tip="Single-stage interactive viewport (G)" />
                        <ToggleButton Classes="studio-toggle"
                                      Content="Grid 4×2"
                                      Padding="6,4"
                                      IsChecked="{Binding IsGridView, Mode=OneWay}"
                                      Click="OnGridViewClick"
                                      ToolTip.Tip="Synchronized 4×2 all-stages grid view (G)" />
                    </StackPanel>

                    <Border Classes="toolbar-sep" Height="20" Margin="1,2,3,2" />

                    <!-- Preset & Export Menus -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,1,2,1">
                        <Button Classes="studio-btn"
                                Content="Preset ▾"
                                Padding="6,4"
                                ToolTip.Tip="Save or load JSON presets (Ctrl+S / Ctrl+Shift+O)">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Save Preset..."
                                              InputGesture="Ctrl+S"
                                              Command="{Binding SavePresetCommand}" />
                                    <MenuItem Header="Load Preset..."
                                              InputGesture="Ctrl+Shift+O"
                                              Command="{Binding LoadPresetCommand}" />
                                    <Separator />
                                    <MenuItem Header="Reset All to Baseline"
                                              Command="{Binding ResetAllCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Classes="studio-btn"
                                Content="Export ▾"
                                Padding="6,4"
                                ToolTip.Tip="Render full resolution and export outputs (Ctrl+E)">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Render Full Resolution"
                                              Command="{Binding RenderFullResolutionCommand}" />
                                    <Separator />
                                    <MenuItem Header="Export Final Image (Full Res)..."
                                              InputGesture="Ctrl+E"
                                              Command="{Binding ExportFinalFullResCommand}" />
                                    <MenuItem Header="Export Final Image (Preview Res)..."
                                              Command="{Binding ExportFinalPreviewResCommand}" />
                                    <Separator />
                                    <MenuItem Header="Export All 24 Stages + Preset..."
                                              InputGesture="Ctrl+Shift+E"
                                              Command="{Binding ExportAllStagesCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </WrapPanel>

                <!-- Right-aligned Inspector, Shortcuts Help & Theme Toggles -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            Margin="4,1,0,1">
                    <ToggleButton Classes="studio-toggle"
                                  Content="Inspector"
                                  Padding="7,4"
                                  IsChecked="{Binding IsInspectorOpen, Mode=TwoWay}"
                                  ToolTip.Tip="Show or hide the stage parameter inspector (I)" />
                    <Button Classes="studio-icon-btn"
                            Content="?"
                            FontSize="12"
                            FontWeight="Bold"
                            ToolTip.Tip="Keyboard shortcuts &amp; navigation tips">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="6" Width="280" Margin="4">
                                    <TextBlock Classes="studio-heading" Text="Keyboard &amp; Canvas Shortcuts" />
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="studio-mono" Text="1 – 8" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="studio-label" Text="Select pipeline stage 1–8" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="studio-mono" Text="G" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="studio-label" Text="Toggle Single / 4×2 Grid view" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="studio-mono" Text="I" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="studio-label" Text="Toggle Inspector sidebar" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="studio-mono" Text="P" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="studio-label" Text="Pin / unpin active stage for compare" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="studio-mono" Text="C" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="studio-label" Text="Toggle A/B Compare on / off" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="studio-mono" Text="\" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Classes="studio-label" Text="Hold-to-Compare reference image" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Classes="studio-mono" Text="Space+Drag" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Classes="studio-label" Text="Pan anywhere (overrides wipe handle)" />
                                        <TextBlock Grid.Row="7" Grid.Column="0" Classes="studio-mono" Text="Ctrl+0 / 1" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Classes="studio-label" Text="Fit to view / Zoom 1:1 (100%)" />
                                        <TextBlock Grid.Row="8" Grid.Column="0" Classes="studio-mono" Text="Ctrl++ / -" />
                                        <TextBlock Grid.Row="8" Grid.Column="1" Classes="studio-label" Text="Zoom in / out around center" />
                                        <TextBlock Grid.Row="9" Grid.Column="0" Classes="studio-mono" Text="Ctrl+Z / Y" />
                                        <TextBlock Grid.Row="9" Grid.Column="1" Classes="studio-label" Text="Undo / Redo parameter edit" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="studio-icon-btn"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="Switch between Dark and Light studio themes">
                        <Panel>
                            <Path IsVisible="{Binding IsDarkTheme}"
                                  Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource StudioForegroundBrush}"
                                  Data="M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,2L14.39,5.42C13.65,5.15 12.84,5 12,5C11.16,5 10.35,5.15 9.61,5.42L12,2M3.34,7L7.5,6.65C6.9,7.16 6.36,7.78 5.94,8.5C5.5,9.24 5.25,10 5.11,10.79L3.34,7M3.36,17L5.12,13.23C5.26,14 5.53,14.78 5.95,15.5C6.37,16.24 6.91,16.86 7.5,17.37L3.36,17M20.65,7L18.88,10.79C18.74,10 18.47,9.23 18.05,8.5C17.63,7.78 17.1,7.15 16.5,6.64L20.65,7M20.64,17L16.5,17.36C17.09,16.85 17.62,16.22 18.04,15.5C18.46,14.77 18.73,14 18.87,13.21L20.64,17M12,22L9.59,18.56C10.33,18.83 11.14,19 12,19C12.82,19 13.63,18.83 14.37,18.56L12,22Z" />
                            <Path IsVisible="{Binding !IsDarkTheme}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource StudioForegroundBrush}"
                                  Data="M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95Z" />
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center Workspace: Viewport / Grid + Resizable Collapsible Stage Inspector -->
        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" MinWidth="280" MaxWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- Viewport or 4x2 Stage Grid -->
            <Panel Grid.Column="0">
                <controls:ZoomPanViewport x:Name="Viewport"
                                          IsVisible="{Binding !IsGridView}"
                                          PrimaryBitmap="{Binding PrimaryBitmap}"
                                          CompareBitmap="{Binding CompareBitmap}"
                                          PrimaryLabel="{Binding PrimaryLabel}"
                                          CompareLabel="{Binding CompareLabel}"
                                          CompareMode="{Binding CompareMode}"
                                          IsHoldComparing="{Binding IsHoldComparing}"
                                          WipePosition="{Binding WipePosition, Mode=TwoWay}"
                                          Zoom="{Binding Zoom, Mode=TwoWay}"
                                          PanX="{Binding PanX, Mode=TwoWay}"
                                          PanY="{Binding PanY, Mode=TwoWay}"
                                          HoverHudText="{Binding HoverHudText}"
                                          HoverHudDetailsText="{Binding HoverHudDetailsText}"
                                          HoverSwatchColor="{Binding HoverSwatchColor}"
                                          AvailableVisualizationModes="{Binding AvailableVisualizationModes}"
                                          SelectedVisualizationMode="{Binding SelectedVisualizationMode, Mode=TwoWay}"
                                          ShowReseedButton="{Binding ShowReseedButton}"
                                          IsEmpty="{Binding !HasImage}"
                                          IsProcessing="{Binding IsBusy}"
                                          ProcessingStatusText="{Binding ProgressText}"
                                          OpenImageCommand="{Binding OpenImageCommand}"
                                          SampleImageCommand="{Binding LoadSampleImageCommand}"
                                          CancelCommand="{Binding CancelRenderCommand}"
                                          ReseedCommand="{Binding ReseedRandomColorsCommand}"
                                          HoverPixelChanged="OnViewportHoverPixelChanged"
                                          HoverExited="OnViewportHoverExited"
                                          FileDropped="OnViewportFileDropped" />

                <views:StageGridView x:Name="StageGrid"
                                     IsVisible="{Binding IsGridView}"
                                     Stages="{Binding Stages}"
                                     SelectedStage="{Binding SelectedStage, Mode=TwoWay}"
                                     Zoom="{Binding GridZoom, Mode=TwoWay}"
                                     PanX="{Binding GridPanX, Mode=TwoWay}"
                                     PanY="{Binding GridPanY, Mode=TwoWay}"
                                     TogglePinStageCommand="{Binding TogglePinStageCommand}"
                                     StageDoubleClicked="OnStageGridDoubleClicked" />
            </Panel>

            <!-- Resizable Inspector Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          ResizeDirection="Columns"
                          Background="Transparent"
                          BorderBrush="{DynamicResource StudioBorderBrush}"
                          BorderThickness="1,0,0,0"
                          IsVisible="{Binding IsInspectorOpen}"
                          ToolTip.Tip="Drag to resize Stage Inspector" />

            <!-- Right Collapsible Stage Inspector Sidebar -->
            <Border Grid.Column="2"
                    Classes="studio-panel"
                    IsVisible="{Binding IsInspectorOpen}">
                <Grid RowDefinitions="Auto,*">
                    <!-- Single Pinned Inspector Header (Unified 1–8 Title, Subtitle, Bypass Toggle, Single Reset) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource StudioSurfaceAltBrush}"
                            BorderBrush="{DynamicResource StudioBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,9">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="studio-muted"
                                           Text="STAGE INSPECTOR"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <TextBlock Classes="studio-heading"
                                           Text="{Binding ActiveStageHeaderTitle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="studio-muted"
                                           Text="{Binding ActiveStageSubtitle}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <ToggleSwitch IsVisible="{Binding ActiveStageHasBypass}"
                                              IsChecked="{Binding ActiveStageIsEnabled, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="Enable or bypass this stage" />
                                <Button Classes="studio-btn"
                                        Content="↺ Reset"
                                        Padding="8,4"
                                        FontSize="11"
                                        IsVisible="{Binding CanResetActiveStage}"
                                        Command="{Binding ResetActiveStageCommand}"
                                        ToolTip.Tip="Reset active stage parameters to baseline" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stage Inspector Host (each inspector manages its own ScrollViewer) -->
                    <Panel Grid.Row="1" x:Name="InspectorHost">
                        <inspectors:InputInspectorView x:Name="InputInspector"
                                                       SourcePathText="{Binding SourceFileDisplayText}"
                                                       NativeDimensionsText="{Binding NativeResolutionText}"
                                                       PreviewDimensionsText="{Binding PreviewResolutionText}"
                                                       BaselineSummaryText="{Binding BaselineSummaryText}"
                                                       PaletteSummaryText="{Binding PaletteSummaryText}"
                                                       HasImage="{Binding HasImage}"
                                                       OpenImageCommand="{Binding OpenImageCommand}"
                                                       RenderFullResCommand="{Binding RenderFullResolutionCommand}"
                                                       ExportFinalCommand="{Binding ExportFinalFullResCommand}" />

                        <inspectors:ColorTransferInspectorView x:Name="ColorTransferInspector"
                                                               IsVisible="False"
                                                               DataContext="{Binding Parameters.ColorTransfer}"
                                                               ResetStageCommand="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ResetStageCommand}"
                                                               ExtractPaletteCommand="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ExtractReferencePaletteCommand}"
                                                               ReferenceThumbnail="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ReferencePaletteThumbnail}"
                                                               ReferenceImageName="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ReferenceImageName}" />

                        <inspectors:SaliencyInspectorView x:Name="SaliencyInspector"
                                                          IsVisible="False"
                                                          DataContext="{Binding Parameters.Saliency}"
                                                          ResetStageCommand="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ResetStageCommand}" />

                        <inspectors:SegmentationInspectorView x:Name="SegmentationInspector"
                                                              IsVisible="False"
                                                              DataContext="{Binding Parameters.Segmentation}"
                                                              ResetStageCommand="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ResetStageCommand}"
                                                              StatsText="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).SegmentationStatsText}" />

                        <inspectors:LodAbstractionInspectorView x:Name="LodAbstractionInspector"
                                                                IsVisible="False"
                                                                DataContext="{Binding Parameters.LodAbstraction}"
                                                                ResetStageCommand="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ResetStageCommand}" />

                        <inspectors:WetInWetInspectorView x:Name="WetInWetInspector"
                                                          IsVisible="False"
                                                          DataContext="{Binding Parameters.WetInWet}"
                                                          ResetStageCommand="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ResetStageCommand}"
                                                          StatsText="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).WetInWetStatsText}" />

                        <inspectors:HandTremorInspectorView x:Name="HandTremorInspector"
                                                            IsVisible="False"
                                                            DataContext="{Binding Parameters.HandTremor}"
                                                            ResetStageCommand="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ResetStageCommand}" />

                        <inspectors:FinishingInspectorView x:Name="FinishingInspector"
                                                           IsVisible="False"
                                                           DataContext="{Binding Parameters.Finishing}"
                                                           ResetStageCommand="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ResetStageCommand}"
                                                           Histogram="{Binding #WindowRoot.((vm:MainWindowViewModel)DataContext).ToneCurveHistogram}" />
                    </Panel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Pipeline Filmstrip -->
        <controls:PipelineFilmstrip Grid.Row="2"
                                    x:Name="Filmstrip"
                                    Stages="{Binding Stages}"
                                    SelectedStage="{Binding SelectedStage, Mode=TwoWay}"
                                    SubStages="{Binding SubStages}"
                                    SelectedSubStage="{Binding SelectedSubStage, Mode=TwoWay}"
                                    ShowSubStageDrawer="{Binding ShowSubStageDrawer}"
                                    ActiveStageSummary="{Binding ActiveStageSummary}"
                                    SelectStageCommand="{Binding SelectPrimaryStageCommand}"
                                    SelectSubStageCommand="{Binding SelectSubStageCommand}"
                                    TogglePinStageCommand="{Binding TogglePinStageCommand}" />

        <!-- Compact Bottom Status Bar -->
        <Border Grid.Row="3" Classes="studio-statusbar">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                <!-- Status & Active Progress -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{DynamicResource StudioAccentBrush}"
                             IsVisible="{Binding IsBusy}"
                             VerticalAlignment="Center" />
                    <TextBlock Classes="studio-label"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Classes="studio-muted"
                               Text="{Binding ProgressText}"
                               IsVisible="{Binding IsBusy}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Cached Full-Res Preview Toggle Pill -->
                <ToggleButton Grid.Column="1"
                              x:Name="FullResPreviewToggle"
                              Classes="studio-toggle"
                              Padding="8,2"
                              MinHeight="22"
                              FontSize="11"
                              IsVisible="{Binding HasCachedFullRes}"
                              IsChecked="{Binding IsViewingFullRes, Mode=TwoWay}"
                              ToolTip.Tip="Toggle between interactive preview and cached full-resolution render">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{DynamicResource StudioCachedBrush}"
                                 IsVisible="{Binding IsViewingFullRes}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FullResToggleLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <!-- Palette Summary -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="studio-muted" Text="Palette:" />
                    <TextBlock Classes="studio-label" Text="{Binding PaletteSummaryText}" />
                </StackPanel>

                <!-- Native Dimensions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="studio-muted" Text="Native:" />
                    <TextBlock Classes="studio-mono" Text="{Binding NativeResolutionText}" />
                </StackPanel>

                <!-- Preview Dimensions -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="studio-muted" Text="Preview:" />
                    <TextBlock Classes="studio-mono" Text="{Binding PreviewResolutionText}" />
                </StackPanel>

                <!-- Cache / Timing Summary -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="studio-muted" Text="Pipeline:" />
                    <TextBlock Classes="studio-mono" Text="{Binding StageTimingSummaryText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Window-Wide Drag-and-Drop Overlay -->
        <Border x:Name="WindowDropOverlay"
                Grid.RowSpan="4"
                Margin="6"
                CornerRadius="12"
                BorderBrush="{DynamicResource StudioDropOverlayBorderBrush}"
                BorderThickness="2"
                Background="{DynamicResource StudioDropOverlayBgBrush}"
                IsHitTestVisible="False"
                IsVisible="False">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20,12"
                    CornerRadius="10"
                    Background="{DynamicResource StudioDropPillBgBrush}"
                    BorderBrush="{DynamicResource StudioAccentBrush}"
                    BorderThickness="1.5">
                <TextBlock Text="Drop image anywhere to open"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StudioForegroundBrush}" />
            </Border>
        </Border>
    </Grid>
</Window>
