<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="StudioCanvasBrush" Color="#11151C" />
                    <SolidColorBrush x:Key="StudioPanelBrush" Color="#161B24" />
                    <SolidColorBrush x:Key="StudioCardBrush" Color="#1C222E" />
                    <SolidColorBrush x:Key="StudioSurfaceAltBrush" Color="#131822" />
                    <SolidColorBrush x:Key="StudioBorderBrush" Color="#2A3344" />
                    <SolidColorBrush x:Key="StudioAccentBrush" Color="#3B82F6" />
                    <SolidColorBrush x:Key="StudioAccentHoverBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="StudioAccentForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StudioStaleBrush" Color="#F59E0B" />
                    <SolidColorBrush x:Key="StudioCachedBrush" Color="#10B981" />
                    <SolidColorBrush x:Key="StudioMutedBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="StudioForegroundBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="StudioSecondaryForegroundBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="StudioHoverBrush" Color="#242C3C" />
                    <SolidColorBrush x:Key="StudioSelectedBrush" Color="#1D3456" />
                    <SolidColorBrush x:Key="StudioDangerBrush" Color="#EF4444" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StudioCanvasBrush" Color="#E6EBF2" />
                    <SolidColorBrush x:Key="StudioPanelBrush" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="StudioCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StudioSurfaceAltBrush" Color="#EDF1F7" />
                    <SolidColorBrush x:Key="StudioBorderBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="StudioAccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="StudioAccentHoverBrush" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="StudioAccentForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StudioStaleBrush" Color="#D97706" />
                    <SolidColorBrush x:Key="StudioCachedBrush" Color="#059669" />
                    <SolidColorBrush x:Key="StudioMutedBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="StudioForegroundBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="StudioSecondaryForegroundBrush" Color="#334155" />
                    <SolidColorBrush x:Key="StudioHoverBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="StudioSelectedBrush" Color="#DBEAFE" />
                    <SolidColorBrush x:Key="StudioDangerBrush" Color="#DC2626" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Studio Typography & Layout Helpers -->
    <Style Selector="TextBlock.studio-heading">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource StudioForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.studio-label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource StudioSecondaryForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.studio-muted">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.studio-mono">
        <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource StudioSecondaryForegroundBrush}" />
    </Style>

    <!-- Studio Containers -->
    <Style Selector="Border.studio-toolbar">
        <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Border.studio-panel">
        <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    </Style>

    <Style Selector="Border.studio-card">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="Border.studio-statusbar">
        <Setter Property="Background" Value="{DynamicResource StudioSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style Selector="Border.toolbar-sep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="4,3" />
        <Setter Property="Background" Value="{DynamicResource StudioBorderBrush}" />
    </Style>

    <!-- Studio Buttons -->
    <Style Selector="Button.studio-btn">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.studio-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioMutedBrush}" />
    </Style>
    <Style Selector="Button.studio-btn:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.studio-accent">
        <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.studio-accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.studio-accent:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.studio-danger">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioDangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ToggleButton.studio-toggle">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioSecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.studio-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.studio-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioForegroundBrush}" />
    </Style>

    <Style Selector="ComboBox.studio-combo">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</Styles>
