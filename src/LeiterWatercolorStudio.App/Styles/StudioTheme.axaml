                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Studio Typography & Layout Helpers -->
    <Style Selector="TextBlock.studio-heading">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource StudioForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.studio-label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource StudioSecondaryForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.studio-muted">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.studio-mono">
        <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource StudioSecondaryForegroundBrush}" />
    </Style>

    <!-- Studio Containers -->
    <Style Selector="Border.studio-toolbar">
        <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Border.studio-panel">
        <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    </Style>

    <Style Selector="Border.studio-card">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="Border.studio-statusbar">
        <Setter Property="Background" Value="{DynamicResource StudioSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style Selector="Border.toolbar-sep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="4,3" />
        <Setter Property="Background" Value="{DynamicResource StudioBorderBrush}" />
    </Style>

    <!-- Studio Buttons -->
    <Style Selector="Button.studio-btn">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.studio-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioMutedBrush}" />
    </Style>
    <Style Selector="Button.studio-btn:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.studio-icon-btn">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.studio-icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioMutedBrush}" />
    </Style>
    <Style Selector="Button.studio-icon-btn:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.studio-icon-btn Path.hold-compare-glyph">
        <Setter Property="Fill" Value="{DynamicResource StudioForegroundBrush}" />
    </Style>
    <Style Selector="Button.studio-icon-btn.hold-active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
    </Style>
    <Style Selector="Button.studio-icon-btn.hold-active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
    </Style>
    <Style Selector="Button.studio-icon-btn.hold-active Path.hold-compare-glyph">
        <Setter Property="Fill" Value="{DynamicResource StudioAccentBrush}" />
    </Style>

    <Style Selector="Button.studio-run-subtle">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioSecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.studio-run-subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioMutedBrush}" />
    </Style>
    <Style Selector="Button.studio-run-subtle:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.studio-chip">
        <Setter Property="Background" Value="{DynamicResource StudioSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioSecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.studio-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioForegroundBrush}" />
    </Style>
    <Style Selector="Button.studio-chip:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.studio-accent">
        <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.studio-accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.studio-accent:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.studio-danger">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioDangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ToggleButton.studio-toggle">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioSecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.studio-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.studio-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StudioSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioForegroundBrush}" />
    </Style>

    <Style Selector="ComboBox.studio-combo">
        <Setter Property="Background" Value="{DynamicResource StudioCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.input-invalid">
        <Setter Property="BorderBrush" Value="{DynamicResource StudioDangerBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="TextBox.input-invalid:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource StudioDangerBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="TextBox.input-invalid:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource StudioDangerBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="TextBlock.validation-error">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource StudioDangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
</Styles>
